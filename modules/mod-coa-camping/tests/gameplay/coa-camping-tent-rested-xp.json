    {"action": "learn", "actor": "owner", "spell": 818},
    {"action": "cast", "actor": "owner", "spell": 818},
    {"action": "assert", "actor": "owner", "metric": "owned_gameobject_count", "entry": 9500200,
      "equals": 1, "within_ms": 15000},
    {"action": "set_skill", "actor": "tenter", "skill": 165, "value": 19, "maximum": 75},
    {"action": "add_item", "actor": "tenter", "item": 2318, "count": 5},
    {"action": "use_gameobject", "actor": "tenter", "entry": 9500200, "owner": "owner"},
    {"action": "gossip_select", "actor": "tenter", "option": 1},
    {"action": "wait", "ms": 2000},
    {"action": "assert", "actor": "tenter", "metric": "owned_gameobject_count", "entry": 9500202, "equals": 0},
    {"action": "assert", "actor": "tenter", "metric": "item_count", "item": 2318, "equals": 5},
    {"action": "assert", "actor": "tenter", "metric": "player_setting", "source": "core.coa.camping",
      "index": 0, "equals": 0},
    {"action": "set_skill", "actor": "tenter", "skill": 165, "value": 20, "maximum": 75},
    {"action": "use_gameobject", "actor": "tenter", "entry": 9500200, "owner": "owner"},
    {"action": "gossip_select", "actor": "tenter", "option": 1},
    {"action": "assert", "actor": "tenter", "metric": "owned_gameobject_count", "entry": 9500202,
      "equals": 1, "within_ms": 2000},
    {"action": "assert", "actor": "tenter", "metric": "gameobject_display", "entry": 9500202, "equals": 7194},
    {"action": "assert", "actor": "tenter", "metric": "gameobject_scale", "entry": 9500202, "equals": 1},
    {"action": "assert", "actor": "tenter", "metric": "item_count", "item": 2318, "equals": 0},
    {"action": "snapshot", "actor": "sleeper", "metric": "next_level_xp", "save_as": "next_level"},
    {"action": "set_rested_xp", "actor": "rested", "value": 3000},
    {"action": "snapshot", "actor": "rested", "metric": "rested_xp", "save_as": "larger_pool"},
    {"action": "client_packet", "actor": "rested", "opcode": 257, "fields": [{"u32": 1}], "consumed": false},
    {"action": "client_packet", "actor": "capped", "opcode": 257, "fields": [{"u32": 1}], "consumed": false},
    {"action": "client_packet", "actor": "sleeper", "opcode": 257, "fields": [{"u32": 1}], "consumed": false},
    {"action": "wait", "ms": 20000},
    {"action": "assert", "actor": "sleeper", "metric": "rested_xp", "equals": 0},
    {"action": "client_packet", "actor": "sleeper", "opcode": 257, "fields": [{"u32": 0}], "consumed": false},
    {"action": "wait", "ms": 100},
    {"action": "client_packet", "actor": "sleeper", "opcode": 257, "fields": [{"u32": 1}], "consumed": false},
    {"action": "wait", "ms": 20000},
    {"action": "assert", "actor": "sleeper", "metric": "rested_xp", "equals": 0},
    {"action": "wait", "ms": 12000},
    {"action": "assert", "actor": "sleeper", "metric": "rested_xp",
