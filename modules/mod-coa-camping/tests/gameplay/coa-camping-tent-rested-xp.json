    {"action": "relog", "actor": "sleeper"},
    {"action": "assert", "actor": "sleeper", "metric": "rested_xp",
      "relative_to": "saved_pool", "min": 0, "max": 1},
    {"action": "assert", "actor": "sleeper", "metric": "player_setting", "source": "core.coa.camping",
      "index": 4, "relative_to": "tent_deadline", "equals": 0},
    {"action": "set_rested_xp", "actor": "sleeper", "value": 0},
    {"action": "client_packet", "actor": "sleeper", "opcode": 257, "fields": [{"u32": 1}], "consumed": false},
    {"action": "set_rested_xp", "actor": "rested", "value": 0},
    {"action": "client_packet", "actor": "rested", "opcode": 257, "fields": [{"u32": 0}], "consumed": false},
    {"action": "wait", "ms": 100},
    {"action": "client_packet", "actor": "rested", "opcode": 257, "fields": [{"u32": 1}], "consumed": false},
    {"action": "wait", "ms": 32000},
    {"action": "assert", "actor": "sleeper", "metric": "rested_xp", "equals": 0},
    {"action": "assert", "actor": "rested", "metric": "rested_xp",
      "ratio_to": "next_level", "min": 0.0499, "max": 0.0501},
    {"action": "assert", "actor": "rested", "metric": "player_setting", "source": "core.coa.camping",
      "index": 4, "min": 1},
    {"action": "relog", "actor": "owner"},
    {"action": "assert", "actor": "tenter", "metric": "owned_gameobject_count", "entry": 9500202,
      "equals": 0, "within_ms": 2000}
