{
  "schema": 1,
  "name": "coa-camping-tent-rested-xp",
  "contract": [
    "Requires enabled camping with CoACamping.AllowSoloContributions=0 and CoACamping.Capacity=3.",
    "A Leatherworking-20 tent costs five Light Leather; a rejected rank-19 request consumes nothing.",
    "Thirty uninterrupted seated seconds raises rested XP to 5% of next-level XP, without reducing a larger pool.",
    "A higher-pool no-op consumes no tent lockout. Tent and contribution deadlines are separate and survive relog.",
    "The native XP award consumes the new pool and doubles the same kill award measured before resting.",
    "Max-level players receive neither rested XP nor a tent lockout. Owner logout removes the tent."
  ],
  "timeout_ms": 400000,
  "location": {"map": 0, "x": -9465, "y": 64, "z": 56, "o": 0},
  "players": [
    {"id": "owner", "race": 1, "class": 1, "level": 20},
    {"id": "tenter", "race": 1, "class": 1, "level": 20},
    {"id": "sleeper", "race": 1, "class": 1, "level": 10},
    {"id": "rested", "race": 1, "class": 1, "level": 10},
    {"id": "capped", "race": 1, "class": 1, "level": 80}
  ],
  "creatures": [{"id": "victim", "owner": "sleeper", "entry": 30, "faction": 14, "level": 10}],
  "steps": [
    {"action": "wait", "ms": 5000},
    {"action": "set_rested_xp", "actor": "sleeper", "value": 0},
