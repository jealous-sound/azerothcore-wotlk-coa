    {"action": "assert", "actor": "sleeper", "metric": "player_setting", "source": "core.coa.camping",
      "index": 0, "equals": 0},
    {"action": "assert", "actor": "sleeper", "metric": "player_setting", "source": "core.coa.camping",
      "index": 4, "min": 1},
    {"action": "assert", "actor": "rested", "metric": "rested_xp", "relative_to": "larger_pool", "equals": 0},
    {"action": "assert", "actor": "rested", "metric": "player_setting", "source": "core.coa.camping",
      "index": 4, "equals": 0},
    {"action": "assert", "actor": "capped", "metric": "rested_xp", "equals": 0},
    {"action": "assert", "actor": "capped", "metric": "player_setting", "source": "core.coa.camping",
      "index": 4, "equals": 0},
    {"action": "snapshot", "actor": "sleeper", "metric": "rested_xp", "save_as": "tent_pool"},
    {"action": "snapshot", "actor": "sleeper", "metric": "xp", "save_as": "before_bonus"},
    {"action": "give_xp", "actor": "sleeper", "amount": 100, "target": "victim"},
    {"action": "assert", "actor": "sleeper", "metric": "xp",
      "relative_to": "before_bonus", "ratio_to": "kill_xp", "equals": 2},
    {"action": "assert", "actor": "sleeper", "metric": "rested_xp",
