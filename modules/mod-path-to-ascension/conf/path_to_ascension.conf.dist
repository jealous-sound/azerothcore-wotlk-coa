###################################################################################################
#  mod-path-to-ascension
#
#  Path to Ascension: the Ascension client's tutorial book (Tutorial.dbc and its companion tables)
#  with verified objective progress, one-time rewards and optional quest-log tracking views.
#
#  The module reads Tutorial.dbc, TutorialCategories.dbc, TutorialObjectives.dbc and
#  TutorialRewards.dbc from DataDir/dbc at startup. A missing or different catalog disables the
#  module with an error; it never replaces client data.
#
#  Progress is kept in the character's core.ascension.* settings. All options are read at startup.
#
#  This code is part of the AzerothCore project. See AUTHORS file for Copyright information.
###################################################################################################

[worldserver]

#    PathToAscension.Enable
#        Description: Load the tutorial catalog and run Path to Ascension.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)
PathToAscension.Enable = 1

#    PathToAscension.RealmProfile
#        Description: The realm column of Tutorial.dbc that decides which tutorials this realm offers:
#                     0 - Live, 1 - Seasonal, 2 - League, 3 - PTR, 4 - Development.
#                     The installed catalog matches the Rexxar PTR data, so PTR offers the complete set.
#                     Tutorials offered here but hidden for the client's own realm type (CoA.RealmType)
#                     are made visible to the client at login.
#        Default:     3 - (PTR)
PathToAscension.RealmProfile = 3

#    PathToAscension.VerifiedProgress.Enable
#        Description: Record objective progress from the server events the module observes.
#        Default:     1 - (Enabled)
PathToAscension.VerifiedProgress.Enable = 1

#    PathToAscension.Rewards.Enable
#        Description: Answer the client's reward claims. Every reward is granted once per character.
#        Default:     1 - (Enabled)
PathToAscension.Rewards.Enable = 1

#    PathToAscension.Tracking.Enable
#        Description: Offer the tutorials' quest-log tracking views. They complete with the tutorial and are
#                     removed when its reward is claimed; they never pay a reward of their own.
#        Default:     1 - (Enabled)
PathToAscension.Tracking.Enable = 1

#    PathToAscension.LegacyContent.Enable
#        Description: Also offer the restored Vanilla and Burning Crusade raid and gear tutorials that have
#                     no Wrath of the Lich King variant. Their objectives and rewards are unchanged.
#        Default:     0 - (Disabled)
PathToAscension.LegacyContent.Enable = 0

#    PathToAscension.StarterMountBridge.Enable
#        Description: Riding trainers hand a character its race's starter mount once, after it learned
#                     Apprentice Riding, so the starter mount tutorials can be completed.
#        Default:     0 - (Disabled)
PathToAscension.StarterMountBridge.Enable = 0
