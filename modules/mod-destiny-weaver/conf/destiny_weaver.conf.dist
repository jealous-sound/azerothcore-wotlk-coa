###################################################################################################
#  mod-destiny-weaver
#
#  The Destiny Weaver NPC and the two per-character choices it offers: open-world level scaling
#  and experience bonus control. Both are stored in `character_settings` under "core.destiny_weaver".
#
#  Both choices are per character. Creatures are scaled for the character who asked for it, and only
#  for them: the level, pool, mana, armor and damage of a creature are delivered per recipient, so two
#  characters can fight the same one at two different levels while everybody else sees it authored.
#  Quest levels and the tuning of what a scaled quest pays are per character as well.
#
#  The realm-wide lift in CoA (CoA.LevelScaling) is a different model - it
#  raises the creature object itself, which every client is told about - so it stands aside while this
#  module owns the answer (see CreatureScalingOwnedPerViewer in LocalLevelScaling.h). Its configuration
#  is left as it is, and it takes over again when DestinyWeaver.LevelScaling is set to 0.
#
#  This code is part of the AzerothCore project. See AUTHORS file for Copyright information.
###################################################################################################

#    DestinyWeaver.Enable
#        Description: Enable the Destiny Weaver menu and both of its services.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)
DestinyWeaver.Enable = 1

#    DestinyWeaver.LevelScaling
#        Description: Whether the scaling service exists at all - open-world creature scaling and
#                     quest scaling together. 0 leaves the choice in the menu without effect: every
#                     creature is met at its authored level and every quest plays at its authored
#                     level, and the realm-wide lift in CoA is handed back.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)
#        Reloadable:  yes (.reload config)
DestinyWeaver.LevelScaling = 1

#    DestinyWeaver.LevelScaling.Default
#        Description: What a character that has never made the choice gets. 1 scales the world and its
#                     quests to the character's own level, 0 leaves both at their authored level until
#                     the character asks for scaling.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)
#        Reloadable:  yes (.reload config)
DestinyWeaver.LevelScaling.Default = 1

#    DestinyWeaver.Scaling.Offset
#        Description: How far below the character a scaled creature sits. A level 40 character pulls
#                     creatures up to level 37 with the default, so the world stays a step behind.
#                     One definition for both models: the per-character view and the realm-wide lift
#                     read the same offset.
#        Default:     3
#        Reloadable:  yes (.reload config)
#
#        The ceiling on how far a creature may be lifted belongs to the realm-wide path
#        (CoA.LevelScalingMaxLift in coa.conf) and is not applied here: a
#        view is delivered to one client, so there is nobody else for a high view to be wrong for.

DestinyWeaver.Scaling.Offset = 3

#    DestinyWeaver.Scaling.QuestMoneyKeepShare
#        Description: How much of a scaled quest's money a quest keeps when it is lifted all the way
#                     from the bottom of the level range to the character's level, in per cent. The
#                     rest is lost in proportion to how much of that range the quest spans, so a
#                     quest at the character's own level always keeps all of it, and 100 turns the
#                     discount off entirely.
#                     The reward class says nothing about level - the median class is the same in
#                     every level band - so paid at full strength a rich quest from a starting zone
#                     would pay what a rich level-appropriate one pays while being trivial to clear.
#                     The discount is what keeps the old zones worth playing without making the easy
#                     content the profitable content: it only ever scales down from what the quest's
#                     class pays at the character's level, so old content can never out-pay
#                     level-appropriate content, and it never reduces a reward below its authored
#                     value.
#        Range:       0-100 (100 = no discount, the quest's class pays in full)
#        Default:     60
#        Reloadable:  yes (.reload config)
DestinyWeaver.Scaling.QuestMoneyKeepShare = 60

#    DestinyWeaver.Scaling.QuestXpKeepShare
#        Description: The same discount for experience. Left at 100 by default: the promise scaling
#                     makes is that scaled content always awards experience, and levelling through
#                     the old zones is exactly what the system is for - discounting experience here
#                     would put the dead zones back. Lower it to bound how much of a character's
#                     progress can come from content far below them.
#        Range:       0-100 (100 = no discount)
#        Default:     100
#        Reloadable:  yes (.reload config)
DestinyWeaver.Scaling.QuestXpKeepShare = 100

#    DestinyWeaver.ExperienceBonusControl
#        Description: Whether the Experience Bonus Control service exists at all. A character who
#                     turns it on stops receiving the bonus experience sources - Potions of
#                     Experience, Auras of Experience and the recruit-a-friend bonus - and
#                     progresses at the base rate.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)
DestinyWeaver.ExperienceBonusControl = 1

#    DestinyWeaver.DisplayStream.Enable
#        Description: Whether a client is told the rows behind this module's character models when
#                     it logs in. The live service streamed them (its client has handlers for
#                     SMSG_PATCH_CREATURE_DISPLAY_INFO and ..._EXTRA and no such rows on disk);
#                     this realm does the same, so the tables here are the single source of truth
#                     and a model change never needs a client patch. 0 leaves whatever the client
#                     already has on disk as its only source, i.e. the patched tables.
#        Default:     1 - (Enabled)
#                     0 - (Disabled)
DestinyWeaver.DisplayStream.Enable = 1
