      "actor": "control",
      "power": 3,
      "value": 0
    },
    {
      "action": "set_power",
      "actor": "rank_one",
      "power": 3,
      "value": 0
    },
    {
      "action": "set_power",
      "actor": "rank_two",
      "power": 3,
      "value": 0
    },
    {
      "action": "wait",
