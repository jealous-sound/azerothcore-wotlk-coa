      "actor": "rank_one",
      "spell": 705102
    },
    {
      "action": "learn",
      "actor": "rank_two",
      "spell": 707842
    },
    {
      "action": "assert",
      "label": "Rank 1 aura amount is +15% (EffectBasePoints 14 + 1, DieSides 1)",
      "actor": "rank_one",
      "metric": "aura_amount",
      "spell": 705102,
      "effect": 0,
      "equals": 15
    },
    {
      "action": "assert",
      "label": "Rank 2 aura amount is +30% (EffectBasePoints 29 + 1, DieSides 1)",
