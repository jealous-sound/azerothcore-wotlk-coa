{
  "schema": 1,
  "name": "Demonborn increases Energy regeneration by 14% or 29% (#2525)",
  "contract": "Demonborn adds 15% (rank 1, 705102) or 30% (rank 2, 707842) Energy regeneration via native SPELL_AURA_MOD_POWER_REGEN_PERCENT (aura 110), applied unconditionally with no class mask to resolve. The DBC stores EffectBasePoints 14/29 with DieSides 1, so SpellEffectInfo::CalcValue resolves them to 15/30 (basePoints+1), one point above the tooltip's 14%/29%.",
  "timeout_ms": 90000,
  "players": [
    {
      "id": "control",
      "race": 1,
      "class": 14,
      "level": 80
    },
    {
      "id": "rank_one",
      "race": 1,
      "class": 14,
      "level": 80
    },
    {
