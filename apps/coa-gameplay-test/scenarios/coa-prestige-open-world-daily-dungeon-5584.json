    "z": -18.34,
    "o": 6.26,
    "ignore_access": true
  },
  "players": [
    {
      "id": "prestiger",
      "race": 1,
      "class": 20,
      "level": 60
    }
  ],
  "steps": [
    {
      "action": "wait",
      "label": "Let the fixture settle",
      "ms": 2000
    },
    {
      "action": "prepare_quest",
      "actor": "prestiger",
      "quest": 80956,
      "complete": false
    },
    {
      "action": "assert",
      "label": "The Open World daily starts with no turned-in quests",
