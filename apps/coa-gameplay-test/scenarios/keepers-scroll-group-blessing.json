{
  "schema": 1,
  "name": "Keeper's Scroll blesses the user and their group in the zone, never an instance",
  "contract": "A Keeper's Scroll blessing belongs to the zone it was used in and to the user's group, whatever each member's faction: at use it reaches the user and the group members in that zone, and a player entering the zone later receives it while they are the user or in the user's group. A player in the same zone outside the group receives neither the buff nor the announcement, and can still use their own scroll; only a player who already holds the blessing is refused. Scrolls cannot be used inside an instance (battlegrounds allow only Featherfall), and entering an instance removes a held blessing.",
  "timeout_ms": 180000,
  "location": { "map": 1, "x": 340.0, "y": -4686.0, "z": 16.5 },
  "players": [
    { "id": "user", "race": 2, "class": 1, "level": 60 },
    { "id": "ally", "race": 1, "class": 1, "level": 60 },
    { "id": "bystander", "race": 2, "class": 1, "level": 60 },
    { "id": "latecomer", "race": 2, "class": 1, "level": 60 }
  ],
  "steps": [
    { "action": "wait", "ms": 5000 },
    { "action": "group", "label": "cross-faction party: the user and an Alliance member", "actor": "user", "target": "ally" },
    { "action": "console", "command": "tele name Harnessd TheCrossroads" },
    { "action": "wait", "ms": 3000 },
    { "action": "add_item", "actor": "user", "item": 1179269 },
    { "action": "use_item", "actor": "user", "item": 1179269, "spell": 91814 },

    { "action": "assert", "label": "the user is blessed", "actor": "user",
      "metric": "aura", "spell": 91814, "equals": 1, "within_ms": 4000 },
    { "action": "assert", "label": "the Alliance group member in the zone is blessed", "actor": "ally",
      "metric": "aura", "spell": 91814, "equals": 1, "within_ms": 4000 },
    { "action": "assert", "label": "a player in the zone outside the group is not blessed", "actor": "bystander",
      "metric": "aura", "spell": 91814, "equals": 0 },
    { "action": "assert", "label": "the user sees the announcement", "actor": "user",
      "metric": "system_message_contains", "text": "used their", "equals": 1 },
    { "action": "assert", "label": "the group member sees the announcement", "actor": "ally",
      "metric": "system_message_contains", "text": "used their", "equals": 1 },
    { "action": "assert", "label": "the player outside the group sees no announcement", "actor": "bystander",
      "metric": "system_message_contains", "text": "used their", "equals": 0 },

    { "action": "add_item", "actor": "bystander", "item": 1179269 },
    { "action": "use_item", "actor": "bystander", "item": 1179269, "spell": 91814 },
    { "action": "assert", "label": "the player outside the group can bless themselves", "actor": "bystander",
      "metric": "aura", "spell": 91814, "equals": 1, "within_ms": 4000 },

    { "action": "add_item", "actor": "ally", "item": 1179269 },
    { "action": "use_item", "actor": "ally", "item": 1179269, "spell": 91814 },
    { "action": "wait", "ms": 2000 },
    { "action": "assert", "label": "an already blessed member is refused", "actor": "ally",
      "metric": "system_message_contains", "text": "already active for you", "equals": 1 },
    { "action": "assert", "label": "and keeps the scroll", "actor": "ally",
      "metric": "item_count", "item": 1179269, "equals": 1 },

    { "action": "group", "label": "the latecomer joins the user's group away from the zone", "actor": "user", "target": "latecomer" },
    { "action": "console", "command": "tele name Harnessd RazorHill" },
    { "action": "assert", "label": "a group member entering the zone later is blessed", "actor": "latecomer",
      "metric": "aura", "spell": 91814, "equals": 1, "within_ms": 6000 },

    { "action": "console", "command": "tele name Harnessb Deadmines" },
    { "action": "assert", "label": "the member reaches the instance", "actor": "ally",
      "metric": "map_id", "equals": 36, "within_ms": 6000 },
    { "action": "assert", "label": "entering an instance removes the blessing", "actor": "ally",
      "metric": "aura", "spell": 91814, "equals": 0, "within_ms": 4000 },
    { "action": "use_item", "actor": "ally", "item": 1179269, "spell": 91814 },
    { "action": "wait", "ms": 2000 },
    { "action": "assert", "label": "a scroll cannot be used inside an instance", "actor": "ally",
      "metric": "system_message_contains", "text": "cannot be used here", "equals": 1 },
    { "action": "assert", "label": "and is not consumed there", "actor": "ally",
      "metric": "item_count", "item": 1179269, "equals": 1 }
  ]
}
