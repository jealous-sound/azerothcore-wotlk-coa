    { "action": "set_aura", "actor": "cleric", "spell": 560124, "stacks": 0 },
    { "action": "assert", "label": "The legacy saved-state fixture retains only the parent", "actor": "cleric", "metric": "aura", "spell": 560123, "equals": 1 },
    { "action": "relog", "actor": "cleric" },
    { "action": "assert", "label": "A legacy parent without a helper is repaired on reload", "actor": "cleric", "metric": "aura", "spell": 560124, "caster": "cleric", "equals": 1 },
    { "action": "snapshot", "actor": "cleric", "metric": "aura_duration_ms", "spell": 560123, "save_as": "legacy_parent_duration" },
    { "action": "assert", "label": "The repaired helper stays bounded to the legacy parent", "actor": "cleric", "metric": "aura_duration_ms", "spell": 560124, "relative_to": "legacy_parent_duration", "min": -100, "max": 100 },
    { "action": "wait", "ms": 500 },
    { "action": "snapshot", "actor": "cleric", "metric": "spell_cast_count", "spell": 853225, "save_as": "legacy_pulses" },
