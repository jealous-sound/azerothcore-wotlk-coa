    { "action": "assert", "label": "The indefinite helper is bounded to the thirty-second parent", "actor": "cleric", "metric": "aura_duration_ms", "spell": 560124, "min": 29000, "max": 30000 },
    { "action": "assert", "label": "The visual helper stays on the caster", "actor": "ally", "metric": "aura", "spell": 560124, "equals": 0 },
    { "action": "wait", "ms": 500 },
