      "opcode": 1701,
      "row": 9,
      "index": 33,
      "equals": 3
    },
    {
      "action": "assert",
      "label": "Vanilla Normal: Molten Core (122) is patched to any expansion",
      "actor": "pvper",
      "metric": "server_packet_u32",
      "opcode": 1701,
      "row": 122,
      "index": 33,
      "equals": 3
    },
    {
      "action": "assert",
