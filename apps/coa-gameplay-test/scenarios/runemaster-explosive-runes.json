  "players": [
    {"id": "rm", "race": 1, "class": 32, "level": 60, "spell_hit_rating": 10000},
    {"id": "ctl", "race": 1, "class": 32, "level": 60, "spell_hit_rating": 10000}
  ],
  "creatures": [
    {"id": "dummy", "owner": "rm", "entry": 36, "level": 60, "health": 1000000, "distance": 3},
    {"id": "dummy_ctl", "owner": "ctl", "entry": 36, "level": 60, "health": 1000000, "distance": 3}
  ],
