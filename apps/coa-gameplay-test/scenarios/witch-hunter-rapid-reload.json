{
  "schema": 1,
  "name": "Rapid Reload grants 8%, 16% and 25% ranged haste (#891)",
  "contract": "Rapid Reload rank 1 705512 reads 'Increases your ranged haste by $s1%.' In the installed Spell.dbc it is a passive, family 21, with one effect: SPELL_AURA_MOD_RANGED_HASTE (140), BasePoints 7 (DieSides 1, so 8%). Ranks 707863 and 712479 carry the same shape with 16% and 25%. AuraEffect::HandleAuraModRangedHaste (SpellAuraEffects.cpp:5012) calls Unit::ApplyAttackTimePercentMod(RANGED_ATTACK), which divides the ranged attack time by 1 + pct/100 (Unit.cpp:14145), so the expected ratios 1/1.08 = 0.9259, 1/1.16 = 0.8621 and 1/1.25 = 0.8 come from the DBC amounts. No script or SQL names any of the three ids. The baseline is read after equipping a crossbow so the ranged swing time is a real weapon speed.",
  "timeout_ms": 60000,
  "players": [
    {"id": "hunter", "race": 1, "class": 15, "level": 80}
  ],
  "steps": [
    {"action": "wait", "label": "Let level scaling settle", "ms": 5000},
    {"action": "learn", "label": "Crossbows skill, as in shadowblast-shadow-rage.json", "actor": "hunter", "spell": 5011},
    {"action": "add_item", "actor": "hunter", "item": 15807},
    {"action": "equip", "actor": "hunter", "item": 15807, "slot": 17},
    {"action": "wait", "label": "Let the weapon swap cooldown expire", "ms": 2000},
    {"action": "snapshot", "label": "Ranged swing time before any haste", "actor": "hunter", "metric": "attack_time_ms", "hand": 2, "save_as": "ranged_base"},
    {"action": "learn", "label": "Rapid Reload rank 1", "actor": "hunter", "spell": 705512},
    {"action": "assert", "label": "Effect 0 is the authored 8%", "actor": "hunter", "metric": "aura_amount", "spell": 705512, "effect": 0, "equals": 8},
    {"action": "assert", "label": "Ranged swing time is 1/1.08 of the base", "actor": "hunter", "metric": "attack_time_ms", "hand": 2, "ratio_to": "ranged_base", "min": 0.921, "max": 0.931, "within_ms": 3000},
    {"action": "unlearn", "label": "Drop Rapid Reload rank 1", "actor": "hunter", "spell": 705512},
    {"action": "assert", "label": "Swing time returns to the base", "actor": "hunter", "metric": "attack_time_ms", "hand": 2, "ratio_to": "ranged_base", "min": 0.999, "max": 1.001, "within_ms": 3000},
    {"action": "learn", "label": "Rapid Reload rank 2", "actor": "hunter", "spell": 707863},
    {"action": "assert", "label": "Effect 0 is the authored 16%", "actor": "hunter", "metric": "aura_amount", "spell": 707863, "effect": 0, "equals": 16},
    {"action": "assert", "label": "Ranged swing time is 1/1.16 of the base", "actor": "hunter", "metric": "attack_time_ms", "hand": 2, "ratio_to": "ranged_base", "min": 0.857, "max": 0.867, "within_ms": 3000},
    {"action": "unlearn", "label": "Drop Rapid Reload rank 2", "actor": "hunter", "spell": 707863},
    {"action": "assert", "label": "Swing time returns to the base", "actor": "hunter", "metric": "attack_time_ms", "hand": 2, "ratio_to": "ranged_base", "min": 0.999, "max": 1.001, "within_ms": 3000},
    {"action": "learn", "label": "Rapid Reload rank 3", "actor": "hunter", "spell": 712479},
    {"action": "assert", "label": "Effect 0 is the authored 25%", "actor": "hunter", "metric": "aura_amount", "spell": 712479, "effect": 0, "equals": 25},
    {"action": "assert", "label": "Ranged swing time is 1/1.25 of the base", "actor": "hunter", "metric": "attack_time_ms", "hand": 2, "ratio_to": "ranged_base", "min": 0.795, "max": 0.805, "within_ms": 3000},
    {"action": "unlearn", "label": "Drop Rapid Reload rank 3", "actor": "hunter", "spell": 712479},
    {"action": "assert", "label": "Swing time returns to the base", "actor": "hunter", "metric": "attack_time_ms", "hand": 2, "ratio_to": "ranged_base", "min": 0.999, "max": 1.001, "within_ms": 3000}
