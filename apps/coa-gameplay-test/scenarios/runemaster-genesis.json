{
  "schema": 1,
  "name": "Issue 462: Genesis stores half of its caster's damage and releases it as Elemental damage",
  "contract": [
    "Genesis 500501 reads 'Apply a runic brand to an enemy for $d, accumulating 50% of your damage dealt, and",
    "unleashing after $d as Elemental Damage. When this deals damage, it triggers your Weapon Engraving.' The brand",
    "lasts duration index 31 (8 s). Effect 0 is a dummy aura naming 500502, the release: SCHOOL_DAMAGE, school mask",
    "28 (Fire, Nature, Frost). Effect 1 carries MiscValueB 50 on aura 69 SPELL_AURA_SCHOOL_ABSORB, which natively only",
    "gives the enemy a 1-point absorb; nothing accumulated or released on main. Expected: the caster's own damage to",
    "the branded enemy while the brand lasts (here only its melee swings, measured as the target's health loss) is",
    "halved and dealt once as 500502 when the brand expires, a resolved copy that neither crits nor takes damage",
    "modifiers twice. Another Runemaster's damage to a target branded by someone else is not stored. The release",
    "then triggers the caster's active Weapon Engraving: with Ice Engraving 653266 (the equip aura of enchant 1004)",
    "that is one Weapon Engraving: Ice strike 653217. Earth and Air engravings have no resolvable effect spell."
  ],
  "timeout_ms": 120000,
  "location": {"map": 0, "x": -8949.95, "y": -132.493, "z": 83.5312, "o": 0},
  "players": [
    {"id": "rm", "race": 1, "class": 32, "level": 80, "melee_hit_rating": 10000, "expertise_rating": 10000,
      "spell_hit_rating": 10000},
    {"id": "other", "race": 1, "class": 32, "level": 80, "melee_hit_rating": 10000, "expertise_rating": 10000,
      "spell_hit_rating": 10000}
  ],
  "creatures": [
    {"id": "dummy", "owner": "rm", "entry": 36, "level": 80, "health": 1000000, "distance": 3}
  ],
  "steps": [
    {"action": "wait", "label": "Let spawn AI settle", "ms": 3000},
    {"action": "learn", "actor": "rm", "spell": 197},
    {"action": "learn", "actor": "other", "spell": 197},
    {"action": "add_item", "actor": "rm", "item": 12784},
    {"action": "add_item", "actor": "other", "item": 12784},
    {"action": "equip", "actor": "rm", "item": 12784, "slot": 15},
    {"action": "equip", "actor": "other", "item": 12784, "slot": 15},
    {"action": "learn", "actor": "rm", "spell": 500501},
    {"action": "snapshot", "actor": "dummy", "metric": "health", "save_as": "dummy_before_brand"},
    {"action": "snapshot", "actor": "rm", "metric": "spell_damage_total", "spell": 500502, "target": "dummy",
      "save_as": "genesis_damage"},

    {"action": "cast", "actor": "rm", "spell": 500501, "target": "dummy"},
    {"action": "assert", "label": "The brand is on the enemy", "actor": "dummy", "metric": "aura",
      "spell": 500501, "caster": "rm", "equals": 1, "within_ms": 1500},
    {"action": "attack", "actor": "rm", "target": "dummy"},
    {"action": "wait", "ms": 5000},
    {"action": "stop_attack", "actor": "rm"},
    {"action": "snapshot", "label": "Damage the caster dealt while the brand lasted", "actor": "dummy",
      "metric": "health", "relative_to": "dummy_before_brand", "save_as": "branded_damage"},
    {"action": "assert", "label": "SETUP: the caster damaged the branded enemy", "actor": "dummy",
      "metric": "health", "relative_to": "dummy_before_brand", "max": -100},
    {"action": "assert", "label": "Nothing is released before the brand ends", "actor": "rm",
      "metric": "spell_damage_count", "spell": 500502, "target": "dummy", "equals": 0},
    {"action": "set_aura", "label": "Ice Engraving becomes active after the stored swings", "actor": "rm",
      "spell": 653266, "stacks": 1},
    {"action": "snapshot", "actor": "rm", "metric": "spell_cast_count", "spell": 653217, "save_as": "ice_strikes"},
    {"action": "assert", "label": "The brand expires after 8 s", "actor": "dummy", "metric": "aura",
      "spell": 500501, "caster": "rm", "equals": 0, "within_ms": 4000},
    {"action": "assert", "label": "Genesis unleashes once", "actor": "rm", "metric": "spell_damage_count",
      "spell": 500502, "target": "dummy", "equals": 1, "within_ms": 1000},
    {"action": "assert", "label": "The release is 50% of the caster's damage to the branded enemy", "actor": "rm",
      "metric": "spell_damage_total", "spell": 500502, "target": "dummy", "relative_to": "genesis_damage",
      "ratio_to": "branded_damage", "min": -0.5001, "max": -0.49},
    {"action": "assert", "label": "The release triggers the active Ice Engraving", "actor": "rm",
      "metric": "spell_cast_count", "spell": 653217, "relative_to": "ice_strikes", "equals": 1, "within_ms": 1000},
    {"action": "set_aura", "actor": "rm", "spell": 653266, "stacks": 0},

    {"action": "reset_cooldown", "actor": "rm", "spell": 500501},
    {"action": "wait", "ms": 1600},
    {"action": "snapshot", "actor": "rm", "metric": "spell_damage_total", "spell": 500502, "target": "dummy",
      "save_as": "genesis_damage_before_other"},
    {"action": "snapshot", "actor": "other", "metric": "melee_damage_total", "save_as": "other_melee"},
    {"action": "cast", "actor": "rm", "spell": 500501, "target": "dummy"},
    {"action": "assert", "actor": "dummy", "metric": "aura", "spell": 500501, "caster": "rm", "equals": 1,
      "within_ms": 1500},
    {"action": "attack", "label": "Another Runemaster hits the enemy branded by rm", "actor": "other",
      "target": "dummy"},
    {"action": "wait", "ms": 5000},
    {"action": "stop_attack", "actor": "other"},
    {"action": "assert", "label": "SETUP: the other Runemaster dealt damage", "actor": "other",
      "metric": "melee_damage_total", "relative_to": "other_melee", "min": 100},
    {"action": "assert", "actor": "dummy", "metric": "aura", "spell": 500501, "caster": "rm", "equals": 0,
      "within_ms": 4000},
    {"action": "wait", "ms": 1000},
    {"action": "assert", "label": "Another player's damage is not stored in rm's brand", "actor": "rm",
      "metric": "spell_damage_total", "spell": 500502, "target": "dummy",
      "relative_to": "genesis_damage_before_other", "equals": 0},
    {"action": "assert", "actor": "other", "metric": "spell_damage_count", "spell": 500502, "equals": 0}
  ]
}
