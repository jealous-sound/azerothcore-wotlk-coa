{
  "schema": 1,
  "name": "Overcorrection converts overhealing into its native five-second heal (#3152)",
  "contract": [
    "Overcorrection 707657 is already read by AscensionChronomancerTime. A normal Correct the Mistake 572360 on a full-health grouped ally must apply helper 561231 and heal over five one-second ticks for 30% of the overhealing, allowing integer rounding per tick.",
    "The ally is lowered only after the parent overheals, so the helper has effective healing to do. Its resolved amount must not receive the caster's healing modifier again. Removing the talent prevents a new helper application."
  ],
  "timeout_ms": 90000,
  "players": [
    {
      "id": "chrono",
      "race": 1,
      "class": 22,
      "level": 80,
      "allow_regeneration": false
    },
    {
      "id": "ally",
      "race": 1,
      "class": 8,
      "level": 80,
      "allow_regeneration": false
    }
  ],
