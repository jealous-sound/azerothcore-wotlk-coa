{
  "schema": 1,
  "name": "Repro: the level-20 Witchhunter purchases that showed no popup",
  "contract": "The three spells bought on the live realm by a level-20 Witchhunter (681095, 804432, 800162) must each be learned and announced with SMSG_LEARNED_SPELL exactly once.",
  "timeout_ms": 180000,
  "players": [
    { "id": "c15", "race": 1, "class": 15, "level": 20 }
  ],
  "steps": [
    { "action": "learn", "actor": "c15", "spell": 97930, "label": "learn the book companion spell" },
    { "action": "cast", "actor": "c15", "spell": 97930, "label": "summon the book" },
    { "action": "assert", "actor": "c15", "metric": "owned_creature_count", "entry": 75115, "equals": 1, "within_ms": 5000, "label": "the book is out" },
    { "action": "gossip_hello", "actor": "c15", "label": "open the book" },
    { "action": "assert", "actor": "c15", "metric": "gossip_options", "equals": 0, "label": "the book answered with a trainer window" },

    { "action": "assert", "actor": "c15", "metric": "spellbook_offers_spell", "spell": 681095, "equals": 1, "label": "681095 is offered" },
    { "action": "assert", "actor": "c15", "metric": "knows_spell", "spell": 681095, "equals": 0, "label": "681095 is not known yet" },
    { "action": "trainer_buy", "actor": "c15", "spell": 681095, "label": "buy 681095" },
    { "action": "assert", "actor": "c15", "metric": "spellbook_buy_succeeded", "spell": 681095, "equals": 1, "label": "681095 was granted" },
    { "action": "assert", "actor": "c15", "metric": "knows_spell", "spell": 681095, "equals": 1, "label": "681095 was learned" },
    { "action": "assert", "actor": "c15", "metric": "spellbook_learned_alerts", "spell": 681095, "equals": 1, "label": "681095 announced itself" },

    { "action": "trainer_buy", "actor": "c15", "spell": 804432, "label": "buy 804432" },
    { "action": "assert", "actor": "c15", "metric": "spellbook_buy_succeeded", "spell": 804432, "equals": 1, "label": "804432 was granted" },
    { "action": "assert", "actor": "c15", "metric": "knows_spell", "spell": 804432, "equals": 1, "label": "804432 was learned" },
    { "action": "assert", "actor": "c15", "metric": "spellbook_learned_alerts", "spell": 804432, "equals": 1, "label": "804432 announced itself" },

    { "action": "trainer_buy", "actor": "c15", "spell": 800162, "label": "buy 800162" },
    { "action": "assert", "actor": "c15", "metric": "spellbook_buy_succeeded", "spell": 800162, "equals": 1, "label": "800162 was granted" },
    { "action": "assert", "actor": "c15", "metric": "knows_spell", "spell": 800162, "equals": 1, "label": "800162 was learned" },
    { "action": "assert", "actor": "c15", "metric": "spellbook_learned_alerts", "spell": 800162, "equals": 1, "label": "800162 announced itself" },

    { "action": "assert", "actor": "c15", "metric": "spellbook_misannounced_buys", "equals": 0, "label": "no purchase was announced more than once" }
  ]
}
