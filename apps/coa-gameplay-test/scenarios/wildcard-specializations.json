{
  "schema": 1,
  "name": "A Wildcard Hero keeps a separate rolled build, scrolls and action bars in each unlocked specialization",
  "contract": "On Darkmoon - Season 10 Wildcard Character Advancement listed 20 specializations. Spec 1 is always known; a Tome of Specialization teaches the swap spell of another (979994 for spec 2, SPEC_SWAP_SPELLS in FrameXML/Constants.lua), and the client unlocks a spec when its swap spell is known. Activating one casts the swap spell (effect 162 with the spec index); the server answers the active spec with SMSG 0x725 {u32 spec (0-based), u32 count} and the spec's build with SMSG 0x726. Every specialization is its own Wildcard build: a fresh spec at level 12 gets the starting choice and then every roll up to its level, has its own Scrolls of Fortune (TOKEN_TYPE_SCROLL_OF_FORTUNE_II... for spec 2, redeemed from Scroll of Fortune II items), its own leveling rewards at Silas (tier = spec index, Scroll of Fortune II and II: Talents) and its own action bars; switching back restores the previous build and bars. Silas refuses the rewards of a locked spec.",
  "timeout_ms": 120000,
  "players": [
    {"id": "wild", "race": 1, "class": 10, "level": 1}
  ],
  "steps": [
    {"action": "wait", "label": "Let login hooks settle", "ms": 3000},
    {"action": "console", "command": "coa gamemode WildCard on Harnessa"},
    {"action": "login_hooks", "actor": "wild"},
    {"action": "assert", "label": "Spec 1 is always known", "actor": "wild", "metric": "knows_spell", "spell": 979993, "equals": 1},
    {"action": "client_packet", "label": "Roll the starting abilities", "actor": "wild", "opcode": 1611},
    {"action": "wait", "ms": 1500},
    {"action": "set_level", "actor": "wild", "value": 12},
    {"action": "client_packet", "label": "Roll at level 10", "actor": "wild", "opcode": 1603, "fields": [{"u32": 0}, {"u32": 0}, {"u32": 0}, {"u8": 0}]},
    {"action": "client_packet", "label": "Roll at level 11", "actor": "wild", "opcode": 1603, "fields": [{"u32": 0}, {"u32": 0}, {"u32": 0}, {"u8": 0}]},
    {"action": "client_packet", "label": "Roll at level 12", "actor": "wild", "opcode": 1603, "fields": [{"u32": 0}, {"u32": 0}, {"u32": 0}, {"u8": 0}]},
    {"action": "wait", "ms": 1500},
    {"action": "assert", "label": "Spec 1 holds seven entries", "actor": "wild", "metric": "wildcard_spells_known", "equals": 7},
    {"action": "set_action_button", "label": "Put the first level roll on the bar", "actor": "wild", "button": 11, "wildcard_slot": 4},
    {"action": "snapshot", "actor": "wild", "metric": "action_button", "button": 11, "save_as": "bar"},

    {"action": "cast", "label": "Try spec 2 without its tome", "actor": "wild", "spell": 979994},
    {"action": "wait", "ms": 7000},
    {"action": "assert", "label": "A locked spec cannot be activated", "actor": "wild", "metric": "player_setting", "source": "core.wildcard.spec", "index": 0, "equals": 0},

    {"action": "learn", "label": "Read a Tome of Specialization II", "actor": "wild", "spell": 979994},
    {"action": "snapshot", "actor": "wild", "metric": "server_packets", "opcode": 1829, "save_as": "specs"},
    {"action": "cast", "label": "Activate spec 2", "actor": "wild", "spell": 979994},
    {"action": "wait", "ms": 7000},
    {"action": "assert", "label": "Spec 2 is active", "actor": "wild", "metric": "player_setting", "source": "core.wildcard.spec", "index": 0, "equals": 1},
    {"action": "assert", "label": "and the client is told", "actor": "wild", "metric": "server_packets", "opcode": 1829, "relative_to": "specs", "equals": 1},
    {"action": "assert", "label": "and rechecks its roll dice", "actor": "wild", "metric": "server_packet_contains", "opcode": 1678, "text": "WILDCARD_ROLL_READY", "equals": 1},
    {"action": "assert", "label": "Spec 2 starts empty", "actor": "wild", "metric": "wildcard_spells_known", "equals": 0},
    {"action": "assert", "label": "and spec 1's spells leave the bar", "actor": "wild", "metric": "action_button", "button": 11, "equals": 0},

    {"action": "client_packet", "label": "Roll spec 2's starting abilities at level 12", "actor": "wild", "opcode": 1611},
    {"action": "wait", "ms": 1500},
    {"action": "assert", "label": "A fresh spec gets its starting choice", "actor": "wild", "metric": "wildcard_spells_known", "equals": 4},
    {"action": "client_packet", "label": "Spec 2 rolls at level 10", "actor": "wild", "opcode": 1603, "fields": [{"u32": 0}, {"u32": 0}, {"u32": 0}, {"u8": 0}]},
    {"action": "client_packet", "label": "Spec 2 rolls at level 11", "actor": "wild", "opcode": 1603, "fields": [{"u32": 0}, {"u32": 0}, {"u32": 0}, {"u8": 0}]},
    {"action": "client_packet", "label": "Spec 2 rolls at level 12", "actor": "wild", "opcode": 1603, "fields": [{"u32": 0}, {"u32": 0}, {"u32": 0}, {"u8": 0}]},
    {"action": "wait", "ms": 1500},
    {"action": "assert", "label": "and every roll up to its level", "actor": "wild", "metric": "wildcard_spells_known", "equals": 7},
    {"action": "assert", "label": "stored as spec 2's build", "actor": "wild", "metric": "player_setting", "source": "core.wildcard.spec2", "index": 4, "min": 1, "max": 1048575},

    {"action": "add_item", "actor": "wild", "item": 97914, "count": 2},
    {"action": "use_item", "label": "Redeem Scrolls of Fortune II: Abilities", "actor": "wild", "item": 97914, "spell": 102783},
    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "They become spec 2's tokens", "actor": "wild", "metric": "player_setting", "source": "core.wildcard.scrolls.spec2", "index": 1, "equals": 2},
    {"action": "assert", "label": "named for spec 2", "actor": "wild", "metric": "server_packet_contains", "opcode": 1648, "text": "TOKEN_TYPE_SCROLL_OF_FORTUNE_II_ABILITIES", "equals": 1},
    {"action": "client_packet", "label": "Claim spec 2's level-10 scrolls at Silas", "actor": "wild", "opcode": 1717, "fields": [{"u32": 1}, {"u32": 1}, {"u8": 1}]},
    {"action": "client_packet", "label": "Claim for the locked spec 3", "actor": "wild", "opcode": 1717, "fields": [{"u32": 2}, {"u32": 1}, {"u8": 1}]},
    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "Spec 2 gets Scrolls of Fortune II", "actor": "wild", "metric": "item_count", "item": 1111244, "equals": 2},
    {"action": "assert", "label": "and Scrolls of Fortune II: Talents", "actor": "wild", "metric": "item_count", "item": 97934, "equals": 6},
    {"action": "assert", "label": "A locked spec has no rewards", "actor": "wild", "metric": "server_packet_contains", "opcode": 1718, "text": "COLLECT_SCROLL_OF_FORTUNE_REWARDS_SPECIALIZATION_OUT_OF_RANGE", "equals": 1},

    {"action": "cast", "label": "Activate spec 1 again", "actor": "wild", "spell": 979993},
    {"action": "wait", "ms": 7000},
    {"action": "assert", "label": "Spec 1 is active", "actor": "wild", "metric": "player_setting", "source": "core.wildcard.spec", "index": 0, "equals": 0},
    {"action": "assert", "label": "with its seven entries", "actor": "wild", "metric": "wildcard_spells_known", "equals": 7},
    {"action": "assert", "label": "and its action bar", "actor": "wild", "metric": "action_button", "button": 11, "relative_to": "bar", "equals": 0},
    {"action": "assert", "label": "which still holds the spell", "actor": "wild", "metric": "action_button", "button": 11, "min": 1},
    {"action": "assert", "label": "Spec 1 kept its own scrolls", "actor": "wild", "metric": "player_setting", "source": "core.wildcard.scrolls", "index": 1, "equals": 0}
  ]
}
