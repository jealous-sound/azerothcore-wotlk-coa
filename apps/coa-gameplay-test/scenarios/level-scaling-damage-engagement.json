{
  "schema": 1,
  "name": "Level scaling: damage before engagement, including a lethal opening hit",
  "contract": "First hits scale before damage; later hits preserve combat level. Requires CoA.LevelScaling=1, CoA.LevelScalingMaxLift=5, MonsterSight=50 and DestinyWeaver.LevelScaling=0 (or DestinyWeaver.Enable=0); setup details are in README.",
  "timeout_ms": 30000,
  "location": {
    "map": 0,
    "x": -9465,
    "y": 64,
    "z": 56,
    "o": 0
  },
  "players": [
    {
      "id": "caster",
      "race": 1,
      "class": 8,
      "level": 80,
      "spell_hit_rating": 10000,
      "melee_hit_rating": 10000,
      "expertise_rating": 10000
    }
  ],
  "creatures": [
    {
      "id": "survivor",
      "owner": "caster",
      "entry": 1501,
      "level": 1,
      "health": 10000,
      "distance": 80,
      "level_scaling": true
    },
    {
      "id": "lethal",
      "owner": "caster",
      "entry": 1501,
      "level": 1,
      "health": 1,
      "distance": 85,
      "level_scaling": true
    }
  ],
  "steps": [
    {
      "action": "wait",
      "ms": 2000,
      "label": "Let the out-of-range periodic scan settle"
    },
    {
      "action": "learn",
      "actor": "caster",
      "spell": 705798
    },
    {
      "action": "assert",
      "actor": "survivor",
      "metric": "level",
      "equals": 1
    },
    {
      "action": "assert",
      "actor": "survivor",
      "metric": "health",
      "equals": 10000
    },
    {
      "action": "assert",
      "actor": "survivor",
      "metric": "max_health",
      "equals": 10000
    },
    {
      "action": "assert",
      "actor": "survivor",
      "metric": "combat",
      "equals": 0
    },
    {
      "action": "cast",
      "actor": "caster",
      "spell": 705798,
      "target": "survivor"
    },
    {
      "action": "assert",
      "actor": "survivor",
      "metric": "level",
      "equals": 6,
      "within_ms": 2000,
      "label": "Scaling precedes damage and the lethal-health check"
    },
    {
      "action": "assert",
      "actor": "survivor",
      "metric": "alive",
      "equals": 1
    },
    {
      "action": "assert",
      "actor": "survivor",
      "metric": "combat",
      "equals": 1
    },
    {
      "action": "snapshot",
      "actor": "survivor",
      "metric": "health",
      "save_as": "survivor_health"
    },
    {
      "action": "assert",
      "actor": "survivor",
      "metric": "health_pct",
      "max": 99.999,
      "label": "The opening hit still removes health"
    },
    {
      "action": "assert",
      "actor": "lethal",
      "metric": "level",
      "equals": 1
    },
    {
      "action": "assert",
      "actor": "lethal",
      "metric": "health",
      "equals": 1
    },
    {
      "action": "assert",
      "actor": "lethal",
      "metric": "max_health",
      "equals": 1
    },
    {
      "action": "assert",
      "actor": "lethal",
      "metric": "combat",
      "equals": 0
    },
    {
      "action": "cast",
      "actor": "caster",
      "spell": 705798,
      "target": "lethal"
    },
    {
      "action": "assert",
      "actor": "lethal",
      "metric": "level",
      "equals": 6,
      "within_ms": 2000,
      "label": "Scaling precedes damage and the lethal-health check"
    },
    {
      "action": "assert",
      "actor": "lethal",
      "metric": "alive",
      "equals": 1
    },
    {
      "action": "assert",
      "actor": "lethal",
      "metric": "combat",
      "equals": 1
    },
    {
      "action": "snapshot",
      "actor": "lethal",
      "metric": "health",
      "save_as": "lethal_health"
    },
    {
      "action": "assert",
      "actor": "lethal",
      "metric": "health_pct",
      "max": 99.999,
      "label": "The opening hit still removes health"
    },
    {
      "action": "set_level",
      "actor": "caster",
      "value": 4
    },
    {
      "action": "cast",
      "actor": "caster",
      "spell": 705798,
      "target": "survivor"
    },
    {
      "action": "assert",
      "actor": "survivor",
      "metric": "health",
      "relative_to": "survivor_health",
      "max": -1,
      "within_ms": 2000,
      "label": "The second hit removes health without a reset"
    },
    {
      "action": "assert",
      "actor": "survivor",
      "metric": "level",
      "equals": 6,
      "label": "An engaged creature does not rescale to the lower-level attacker"
    }
  ]
}
