{
  "schema": 1,
  "name": "CoA item stream: a newly rewarded scaled item is patched once",
  "contract": [
    "Requires CoA.SendDisplayPatches=1, CoA.ItemScaling=1, DestinyWeaver.Enable=1 and CoA.QuestLevelScaling=1.",
    "A level-32 viewer plays quest 9146 (authored at 12) at 28 on its QuestTemplateScaling.dbc row and receives Farstrider's Tunic 23405, which has no ItemStat.dbc ladder, as a copy lifted by 15 item levels (16 rounded down to a five-level step): item level 27.",
    "Storing that copy must immediately send one eight-field item patch even though it is absent from item_dbc.",
    "Repeating the world-entry notice must not send its row again."
  ],
  "timeout_ms": 60000,
  "location": {
    "map": 0,
    "x": -9465,
    "y": 64,
    "z": 56,
    "o": 0
  },
  "players": [
    {
      "id": "viewer",
      "race": 1,
      "class": 12,
      "level": 32
    }
  ],
  "steps": [
    {
      "action": "client_packet",
      "actor": "viewer",
      "opcode": 1377
    },
    {
      "action": "wait",
      "ms": 100
    },
    {
      "action": "level_scaling_packet",
      "actor": "viewer",
      "value": 1
    },
    {
      "action": "prepare_quest",
      "actor": "viewer",
      "quest": 9146
    },
    {
      "action": "snapshot",
      "actor": "viewer",
      "metric": "server_packets",
      "opcode": 2354,
      "save_as": "before_reward"
    },
    {
      "action": "reward_quest",
      "actor": "viewer",
      "quest": 9146,
      "choice": 0
    },
    {
      "action": "assert",
      "actor": "viewer",
      "metric": "carried_item_level",
      "item": 23405,
      "equals": 27
    },
    {
      "action": "assert",
      "actor": "viewer",
      "metric": "server_packets",
      "opcode": 2354,
      "relative_to": "before_reward",
      "equals": 1
    },
    {
      "action": "snapshot",
      "actor": "viewer",
      "metric": "server_packets",
      "opcode": 2354,
      "save_as": "before_world_entry"
    },
    {
      "action": "client_packet",
      "actor": "viewer",
      "opcode": 1377
    },
    {
      "action": "wait",
      "ms": 100
    },
    {
      "action": "assert",
      "actor": "viewer",
      "metric": "server_packets",
      "opcode": 2354,
      "relative_to": "before_world_entry",
      "equals": 0
    }
  ]
}
