    { "action": "assert", "label": "Effect 1 (attack power of stat) is inert at 0", "actor": "b", "metric": "aura_amount", "spell": 561160, "effect": 1, "equals": 0 },
    { "action": "assert", "label": "Strength rises by 25% (widened for rounding)", "actor": "b", "metric": "stat", "stat": 0, "ratio_to": "str0", "min": 1.2, "max": 1.3, "within_ms": 3000 },
