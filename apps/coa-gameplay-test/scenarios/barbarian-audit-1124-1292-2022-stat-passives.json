    { "action": "snapshot", "label": "Baseline Strength", "actor": "b", "metric": "stat", "stat": 0, "save_as": "str0" },
    { "action": "learn", "actor": "b", "spell": 804728 },
    { "action": "assert", "label": "Powerful Grip (804728) is active", "actor": "b", "metric": "aura", "spell": 804728, "equals": 1, "within_ms": 3000 },
    { "action": "assert", "label": "Effect 0 (disarm duration cut) resolves to -30", "actor": "b", "metric": "aura_amount", "spell": 804728, "effect": 0, "equals": -30 },
    { "action": "assert", "label": "Strength rises by exactly 25 (flat)", "actor": "b", "metric": "stat", "stat": 0, "relative_to": "str0", "equals": 25, "within_ms": 3000 },
    { "action": "unlearn", "actor": "b", "spell": 804728 },
    { "action": "assert", "label": "Unlearning restores Strength", "actor": "b", "metric": "stat", "stat": 0, "relative_to": "str0", "equals": 0, "within_ms": 3000 },

