    {"action": "snapshot", "actor": "rm", "metric": "spell_proc_count", "spell": 707150, "save_as": "runes_bare"},
    {"action": "cast", "actor": "rm", "spell": 645435, "target": "shaman"},
    {"action": "assert", "actor": "rm", "metric": "aura", "spell": 645435, "equals": 1, "within_ms": 500},
    {"action": "assert", "actor": "rm", "metric": "aura", "spell": 645435, "equals": 0, "within_ms": 4000},
