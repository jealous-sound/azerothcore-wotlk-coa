{
  "schema": 1,
  "name": "Trial completion and repeat item rewards follow the account (#4569)",
  "contract": "Issue #4569 requires the completion tick and reduced repeat item rewards to follow an account, including characters with no personal completion. The user clarified that achievements remain per character. Personal Nightmare 64 and Prestige Personal Nightmare 278 have distinct identities. World reward rows give first-only Ny'alotha Allseer 499363 and repeat rewards 77249 (normal) or 100646 (Prestige). Achievement.dbc identifies Warrior 24935 and Paladin 24955 as the corresponding class achievements. Native start packets and GiveLevel to the configured level cap complete each trial; no completion rows or reward outcomes are seeded. Relog checks the completed-list packet 0x597 and persisted mail. Shared disposable-account fixtures model character ownership, not simultaneous client authentication. The Prestige aura is fixture setup. Client rendering and cross-realm sharing are outside this native check.",
  "timeout_ms": 600000,
  "players": [
    {"id": "first", "race": 1, "class": 1, "level": 1},
    {"id": "alt", "race": 1, "class": 2, "level": 1, "account_of": "first"},
    {"id": "prestige", "race": 1, "class": 1, "level": 1, "account_of": "first"},
    {"id": "other", "race": 1, "class": 2, "level": 1}
  ],
  "steps": [
    {"action": "wait", "ms": 3000},
    {"action": "assert", "actor": "alt", "metric": "server_packet_u32", "opcode": 1431, "index": 0, "equals": 0, "label": "The account starts without completed trials"},
    {"action": "start_challenge", "actor": "first", "challenge": 64, "level": 1},
    {"action": "assert", "actor": "first", "metric": "challenge_start_code", "equals": 0},
    {"action": "set_level", "actor": "first", "value": 80},
    {"action": "assert", "actor": "first", "metric": "server_packet_u32", "opcode": 1432, "index": 1, "equals": 64, "within_ms": 2000, "label": "Reaching the cap completes Personal Nightmare"},
    {"action": "relog", "actor": "first"},
    {"action": "assert", "actor": "first", "metric": "mail_has_item", "item": 499363, "equals": 1, "label": "The first completion grants the first-only mount"},
    {"action": "assert", "actor": "first", "metric": "mail_has_item", "item": 77249, "equals": 1},
    {"action": "assert", "actor": "first", "metric": "has_achievement", "achievement": 24935, "equals": 1},
    {"action": "relog", "actor": "alt"},
    {"action": "assert", "actor": "alt", "metric": "server_packet_u32", "opcode": 1431, "index": 0, "equals": 1, "label": "A character without its own completion receives the account tick"},
    {"action": "assert", "actor": "alt", "metric": "server_packet_u32", "opcode": 1431, "index": 2, "equals": 64},
    {"action": "assert", "actor": "alt", "metric": "server_packet_u32", "opcode": 1431, "index": 3, "equals": 1},
    {"action": "assert", "actor": "alt", "metric": "has_achievement", "achievement": 24955, "equals": 0, "label": "Sharing completion does not grant the alt an unearned achievement"},
    {"action": "relog", "actor": "other"},
    {"action": "assert", "actor": "other", "metric": "server_packet_u32", "opcode": 1431, "index": 0, "equals": 0, "label": "Another account does not inherit completion"},
    {"action": "start_challenge", "actor": "alt", "challenge": 64, "level": 1},
    {"action": "assert", "actor": "alt", "metric": "challenge_start_code", "equals": 0, "label": "Account completion does not prevent the alt from taking the trial"},
    {"action": "set_level", "actor": "alt", "value": 80},
    {"action": "assert", "actor": "alt", "metric": "server_packet_u32", "opcode": 1432, "index": 1, "equals": 64, "within_ms": 2000},
    {"action": "relog", "actor": "alt"},
    {"action": "assert", "actor": "alt", "metric": "mail_has_item", "item": 499363, "equals": 0, "label": "Repeating on the account omits first-only items"},
    {"action": "assert", "actor": "alt", "metric": "mail_has_item", "item": 77249, "equals": 1, "label": "Repeat completion still mails the repeat reward"},
    {"action": "assert", "actor": "alt", "metric": "has_achievement", "achievement": 24955, "equals": 1, "label": "The alt earns its own Paladin achievement"},
    {"action": "assert", "actor": "alt", "metric": "server_packet_u32", "opcode": 1431, "index": 0, "equals": 1, "label": "Personal and account records produce one completion row"},
    {"action": "set_aura", "actor": "prestige", "spell": 9930831, "stacks": 1},
    {"action": "assert", "actor": "prestige", "metric": "aura", "spell": 9930831, "equals": 1},
    {"action": "start_challenge", "actor": "prestige", "challenge": 278, "level": 1},
    {"action": "assert", "actor": "prestige", "metric": "challenge_start_code", "equals": 0},
    {"action": "set_level", "actor": "prestige", "value": 80},
    {"action": "assert", "actor": "prestige", "metric": "server_packet_u32", "opcode": 1432, "index": 1, "equals": 278, "within_ms": 2000},
    {"action": "relog", "actor": "prestige"},
    {"action": "assert", "actor": "prestige", "metric": "mail_has_item", "item": 499363, "equals": 1, "label": "The first Prestige completion still grants full item rewards"},
    {"action": "assert", "actor": "prestige", "metric": "mail_has_item", "item": 100646, "equals": 1},
    {"action": "assert", "actor": "prestige", "metric": "has_achievement", "achievement": 24935, "equals": 1},
    {"action": "relog", "actor": "first"},
    {"action": "assert", "actor": "first", "metric": "server_packet_u32", "opcode": 1431, "index": 0, "equals": 2, "label": "Normal and Prestige completions remain separate"},
    {"action": "assert", "actor": "first", "metric": "server_packet_u32", "opcode": 1431, "index": 2, "equals": 64},
    {"action": "assert", "actor": "first", "metric": "server_packet_u32", "opcode": 1431, "index": 9, "equals": 278},
    {"action": "start_challenge", "actor": "other", "challenge": 64, "level": 1},
    {"action": "assert", "actor": "other", "metric": "challenge_start_code", "equals": 0},
    {"action": "set_level", "actor": "other", "value": 80},
    {"action": "assert", "actor": "other", "metric": "server_packet_u32", "opcode": 1432, "index": 1, "equals": 64, "within_ms": 2000},
    {"action": "relog", "actor": "other"},
    {"action": "assert", "actor": "other", "metric": "mail_has_item", "item": 499363, "equals": 1, "label": "An unrelated account still receives its full first reward"},
    {"action": "assert", "actor": "other", "metric": "mail_has_item", "item": 77249, "equals": 1},
    {"action": "assert", "actor": "other", "metric": "has_achievement", "achievement": 24955, "equals": 1}
  ]
}
