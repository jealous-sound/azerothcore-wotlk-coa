    {"action": "cast", "actor": "rm", "spell": 803018, "target": "enemy"},
    {"action": "assert", "label": "SETUP: second Fracture hits", "actor": "rm", "metric": "spell_damage_count",
      "spell": 803018, "target": "enemy", "relative_to": "fracture_hits", "equals": 2, "within_ms": 2000},
    {"action": "wait", "ms": 1700},

    {"action": "set_aura", "actor": "rm", "spell": 500288, "stacks": 1},
    {"action": "reset_cooldown", "actor": "mage", "spell": 122},
    {"action": "cast", "actor": "mage", "spell": 122},
    {"action": "assert", "label": "SETUP: the enemy is frozen a third time", "actor": "enemy", "metric": "aura",
      "spell": 122, "caster": "mage", "equals": 1, "within_ms": 2000},
    {"action": "cast", "actor": "rm", "spell": 803018, "target": "enemy"},
    {"action": "assert", "label": "SETUP: third Fracture hits", "actor": "rm", "metric": "spell_damage_count",
      "spell": 803018, "target": "enemy", "relative_to": "fracture_hits", "equals": 3, "within_ms": 2000},
    {"action": "wait", "ms": 1700},

    {"action": "set_aura", "actor": "rm", "spell": 500288, "stacks": 1},
    {"action": "reset_cooldown", "actor": "mage", "spell": 122},
    {"action": "cast", "actor": "mage", "spell": 122},
    {"action": "assert", "label": "SETUP: the enemy is frozen a fourth time", "actor": "enemy", "metric": "aura",
      "spell": 122, "caster": "mage", "equals": 1, "within_ms": 2000},
    {"action": "cast", "actor": "rm", "spell": 803018, "target": "enemy"},
    {"action": "assert", "label": "SETUP: fourth Fracture hits", "actor": "rm", "metric": "spell_damage_count",
      "spell": 803018, "target": "enemy", "relative_to": "fracture_hits", "equals": 4, "within_ms": 2000},

    {"action": "assert", "label": "Every Fracture against a frozen target is a critical strike", "actor": "rm",
      "metric": "spell_damage_count", "spell": 803018, "target": "enemy", "critical": true,
      "relative_to": "fracture_crits", "equals": 4}
  ]
