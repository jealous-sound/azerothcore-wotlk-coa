    {"action": "set_aura", "label": "Volcanic Fury adds 400 attack power", "actor": "rm", "spell": 67391,
      "stacks": 1},
    {"action": "assert", "label": "SETUP: attack power increased", "actor": "rm", "metric": "attack_power",
      "relative_to": "attack_power_before", "min": 300},
    {"action": "snapshot", "actor": "rm", "metric": "attack_power", "relative_to": "attack_power_before",
