    {"action": "cast", "actor": "rm", "spell": 803018, "target": "enemy"},
    {"action": "assert", "label": "SETUP: first Fracture hits", "actor": "rm", "metric": "spell_damage_count",
      "spell": 803018, "target": "enemy", "relative_to": "fracture_hits", "equals": 1, "within_ms": 2000},
    {"action": "wait", "ms": 1700},

    {"action": "set_aura", "actor": "rm", "spell": 500288, "stacks": 1},
    {"action": "reset_cooldown", "actor": "mage", "spell": 122},
