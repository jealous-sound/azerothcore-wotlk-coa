      "ratio_to": "attack_power_gain", "min": 1.35, "max": 1.7},
    {"action": "assert", "label": "Fracture's mana burn gains 0.35 per attack power", "actor": "rm",
      "metric": "spell_effect_value", "spell": 803018, "effect": 2, "relative_to": "mana_burn_before",
      "ratio_to": "attack_power_gain", "min": 0.33, "max": 0.37},
    {"action": "set_aura", "actor": "rm", "spell": 67391, "stacks": 0},
    {"action": "assert", "label": "SETUP: an unfrozen Fracture is far from a certain crit", "actor": "rm",
