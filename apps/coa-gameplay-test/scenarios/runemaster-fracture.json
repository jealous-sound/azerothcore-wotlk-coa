    {"action": "set_aura", "label": "Runeshroud grants stealth", "actor": "rm", "spell": 500288, "stacks": 1},
    {"action": "cast", "label": "Frost Nova freezes the enemy", "actor": "mage", "spell": 122},
    {"action": "assert", "label": "SETUP: the enemy is frozen", "actor": "enemy", "metric": "aura", "spell": 122,
