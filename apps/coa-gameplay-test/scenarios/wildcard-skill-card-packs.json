{
  "schema": 1,
  "name": "Wildcard sealed card packs reveal five cards into the account's skill card collection",
  "contract": "On Darkmoon - Season 10 Wildcard a sealed card pack (Ability 97885, Golden Ability 778998, Talent 97886, Golden Talent 97870) was the token of a sealed card purchase: using the item opened one pack and the Skill Cards window on its Boosters tab (SMSG 0x68E SKILL_CARD_COLLECTION_ITEM_USED), whose pack buttons sent CMSG 0x66A {str PURCHASE_SEALED_CARD_TYPE_*_PACK, u32 amount}. The server took one pack per amount and laid five cards of the pack's type out as pending (SMSG 0x654), answering SMSG 0x66B PURCHASE_SEALED_CARD_OK or the reason (NO_TOKEN, UNCLAIMED_CARDS while cards wait, BAD_TYPE, BAD_AMOUNT, RANDOM_MODE_NOT_ENABLED outside Wildcard). A pack draws from all cards of its kind, so it can repeat cards the account already owns. Revealing sent CMSG 0x656 {u32 n, n x {str name, u32 card, u32 rank}}; the server moved the cards into the collection (SMSG 0x655 removed, 0x649 collected, 0x657 CLAIM_SKILL_CARD_OK), and each skill card opened is another ticket: a Darkmoon Ticket (246190) for a normal card, a Golden Darkmoon Ticket (97399) for a golden one. Duplicates fill the Extra Booster Progress bar (1/2/4/8/10 by rarity, a Sealed Card Pack at 100). Tickets bought three uncollected talent cards of one rarity from the Card Packs tab (PURCHASE_SEALED_CARD_TYPE_*_TALENTS) at the SealedCardCosts price of the account's next purchase, rising with every purchase. Silas Darkmoon sold booster packs for 50 gold each (CMSG 0x6DD {u32 count} -> SMSG 0x6DE), one Golden Ability and one Golden Talent pack per booster.",
  "timeout_ms": 60000,
  "players": [
    {"id": "wild", "race": 1, "class": 10, "level": 10},
    {"id": "plain", "race": 1, "class": 10, "level": 10}
  ],
  "steps": [
    {"action": "wait", "label": "Let login hooks settle", "ms": 3000},
    {"action": "console", "command": "coa gamemode WildCard on Harnessa"},
    {"action": "console", "command": "coa gamemode WildCard off Harnessb"},

    {"action": "client_packet", "label": "Open a pack without one", "actor": "wild", "opcode": 1642, "fields": [{"string": "PURCHASE_SEALED_CARD_TYPE_DEFAULT_PACK"}, {"u32": 1}]},
    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "A pack is the token", "actor": "wild", "metric": "server_packet_contains", "opcode": 1643, "text": "PURCHASE_SEALED_CARD_NO_TOKEN", "equals": 1},

    {"action": "snapshot", "actor": "wild", "metric": "server_packets", "opcode": 1608, "save_as": "collections"},
    {"action": "add_item", "actor": "wild", "item": 97885, "count": 3},
    {"action": "use_item", "label": "Use a pack from the bag", "actor": "wild", "item": 97885, "spell": 93330},
    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "The client opens the Boosters tab", "actor": "wild", "metric": "server_packet_contains", "opcode": 1678, "text": "SKILL_CARD_COLLECTION_ITEM_USED", "equals": 1},
    {"action": "assert", "label": "Using the pack opens it", "actor": "wild", "metric": "server_packet_contains", "opcode": 1643, "text": "PURCHASE_SEALED_CARD_OK", "equals": 1},
    {"action": "assert", "label": "Five cards wait to be revealed", "actor": "wild", "metric": "wildcard_cards_pending", "equals": 5},
    {"action": "assert", "label": "in one pending list", "actor": "wild", "metric": "server_packets", "opcode": 1620, "equals": 1},
    {"action": "assert", "label": "One pack is used up", "actor": "wild", "metric": "item_count", "item": 97885, "equals": 2},

    {"action": "client_packet", "label": "Open another pack before revealing", "actor": "wild", "opcode": 1642, "fields": [{"string": "PURCHASE_SEALED_CARD_TYPE_DEFAULT_PACK"}, {"u32": 1}]},
    {"action": "client_packet", "label": "Buy ability cards with tickets", "actor": "wild", "opcode": 1642, "fields": [{"string": "PURCHASE_SEALED_CARD_TYPE_NORMAL_EPIC_ABILITIES"}, {"u32": 1}]},
    {"action": "client_packet", "label": "Buy an unknown kind of card", "actor": "wild", "opcode": 1642, "fields": [{"string": "PURCHASE_SEALED_CARD_TYPE_MAX"}, {"u32": 1}]},
    {"action": "client_packet", "label": "Open no pack", "actor": "wild", "opcode": 1642, "fields": [{"string": "PURCHASE_SEALED_CARD_TYPE_DEFAULT_PACK"}, {"u32": 0}]},
    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "Pending cards come first", "actor": "wild", "metric": "server_packet_contains", "opcode": 1643, "text": "PURCHASE_SEALED_CARD_UNCLAIMED_CARDS", "equals": 1},
    {"action": "assert", "label": "Ability cards have no ticket price", "actor": "wild", "metric": "server_packet_contains", "opcode": 1643, "text": "PURCHASE_SEALED_CARD_BAD_COST", "equals": 1},
    {"action": "assert", "label": "Unknown kinds are refused", "actor": "wild", "metric": "server_packet_contains", "opcode": 1643, "text": "PURCHASE_SEALED_CARD_BAD_TYPE", "equals": 1},
    {"action": "assert", "label": "An amount is needed", "actor": "wild", "metric": "server_packet_contains", "opcode": 1643, "text": "PURCHASE_SEALED_CARD_BAD_AMOUNT", "equals": 1},
    {"action": "assert", "label": "The packs stay", "actor": "wild", "metric": "item_count", "item": 97885, "equals": 2},

    {"action": "client_packet", "label": "Reveal two cards", "actor": "wild", "opcode": 1622, "fields": [{"wildcard_pending_cards": 2}]},
    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "The reveal is accepted", "actor": "wild", "metric": "server_packet_contains", "opcode": 1623, "text": "CLAIM_SKILL_CARD_OK", "equals": 1},
    {"action": "assert", "label": "Two cards join the collection", "actor": "wild", "metric": "wildcard_cards_collected", "equals": 2},
    {"action": "assert", "label": "Three still wait", "actor": "wild", "metric": "wildcard_cards_pending", "equals": 3},
    {"action": "assert", "label": "The client drops them from the pending list", "actor": "wild", "metric": "server_packets", "opcode": 1621, "equals": 1},
    {"action": "assert", "label": "and adds them to its collection", "actor": "wild", "metric": "server_packets", "opcode": 1609, "equals": 1},

    {"action": "client_packet", "label": "Reveal the rest", "actor": "wild", "opcode": 1622, "fields": [{"wildcard_pending_cards": 5}]},
    {"action": "client_packet", "label": "Open the second pack", "actor": "wild", "opcode": 1642, "fields": [{"string": "PURCHASE_SEALED_CARD_TYPE_DEFAULT_PACK"}, {"u32": 1}]},
    {"action": "wait", "ms": 500},
    {"action": "client_packet", "label": "Reveal the second pack", "actor": "wild", "opcode": 1622, "fields": [{"wildcard_pending_cards": 5}]},
    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "Two packs add up to ten cards to the collection, duplicates aside", "actor": "wild", "metric": "wildcard_cards_collected", "min": 8, "max": 10},
    {"action": "assert", "label": "Each revealed card pays a Darkmoon Ticket", "actor": "wild", "metric": "item_count", "item": 246190, "equals": 10},
    {"action": "assert", "label": "Nothing waits", "actor": "wild", "metric": "wildcard_cards_pending", "equals": 0},
    {"action": "assert", "label": "Each opened pack refreshes the collection", "actor": "wild", "metric": "server_packets", "opcode": 1608, "relative_to": "collections", "equals": 2},
    {"action": "assert", "label": "Two packs are used up", "actor": "wild", "metric": "item_count", "item": 97885, "equals": 1},

    {"action": "client_packet", "label": "Buy three rare talent cards with ten tickets", "actor": "wild", "opcode": 1642, "fields": [{"string": "PURCHASE_SEALED_CARD_TYPE_NORMAL_RARE_TALENTS"}, {"u32": 1}]},
    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "Rare talent cards cost more", "actor": "wild", "metric": "server_packet_contains", "opcode": 1643, "text": "PURCHASE_SEALED_CARD_NO_TOKEN", "equals": 1},
    {"action": "add_item", "actor": "wild", "item": 246190, "count": 190},
    {"action": "client_packet", "label": "Buy them with 200 tickets", "actor": "wild", "opcode": 1642, "fields": [{"string": "PURCHASE_SEALED_CARD_TYPE_NORMAL_RARE_TALENTS"}, {"u32": 1}]},
    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "Three uncollected rare talent cards wait", "actor": "wild", "metric": "wildcard_cards_pending", "equals": 3},
    {"action": "assert", "label": "for 200 tickets", "actor": "wild", "metric": "item_count", "item": 246190, "equals": 0},
    {"action": "client_packet", "label": "Reveal the bought cards", "actor": "wild", "opcode": 1622, "fields": [{"wildcard_pending_cards": 3}]},
    {"action": "wait", "ms": 500},
    {"action": "add_item", "actor": "wild", "item": 246190, "count": 397},
    {"action": "client_packet", "label": "Buy rare talent cards again", "actor": "wild", "opcode": 1642, "fields": [{"string": "PURCHASE_SEALED_CARD_TYPE_NORMAL_RARE_TALENTS"}, {"u32": 1}]},
    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "The second purchase costs 400 tickets", "actor": "wild", "metric": "item_count", "item": 246190, "equals": 0},
    {"action": "assert", "label": "and lays out three more cards", "actor": "wild", "metric": "wildcard_cards_pending", "equals": 3},
    {"action": "client_packet", "label": "Reveal them too", "actor": "wild", "opcode": 1622, "fields": [{"wildcard_pending_cards": 3}]},
    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "Bought cards are new to the collection", "actor": "wild", "metric": "wildcard_cards_collected", "min": 14, "max": 16},

    {"action": "set_money", "actor": "wild", "value": 1000000},
    {"action": "client_packet", "label": "Buy two boosters from Silas", "actor": "wild", "opcode": 1757, "fields": [{"u32": 2}]},
    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "The boosters are sold", "actor": "wild", "metric": "server_packet_contains", "opcode": 1758, "text": "PURCHASE_SEALED_CARD_BOOSTER_PACK_OK", "equals": 1},
    {"action": "assert", "label": "They cost 50 gold each", "actor": "wild", "metric": "carried_money", "equals": 0},
    {"action": "assert", "label": "Each holds a Golden Ability pack", "actor": "wild", "metric": "item_count", "item": 778998, "equals": 2},
    {"action": "assert", "label": "and a Golden Talent pack", "actor": "wild", "metric": "item_count", "item": 97870, "equals": 2},

    {"action": "client_packet", "label": "Buy a booster without gold", "actor": "wild", "opcode": 1757, "fields": [{"u32": 1}]},
    {"action": "client_packet", "label": "Buy no booster", "actor": "wild", "opcode": 1757, "fields": [{"u32": 0}]},
    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "Boosters need gold", "actor": "wild", "metric": "server_packet_contains", "opcode": 1758, "text": "PURCHASE_SEALED_CARD_BOOSTER_PACK_NO_MONEY", "equals": 1},
    {"action": "assert", "label": "and a count", "actor": "wild", "metric": "server_packet_contains", "opcode": 1758, "text": "PURCHASE_SEALED_CARD_BOOSTER_PACK_TOO_FEW", "equals": 1},

    {"action": "client_packet", "label": "Open a Golden Talent pack", "actor": "wild", "opcode": 1642, "fields": [{"string": "PURCHASE_SEALED_CARD_TYPE_DEFAULT_GOLDEN_TALENT_PACK"}, {"u32": 2}]},
    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "Two golden talent packs lay out ten cards", "actor": "wild", "metric": "wildcard_cards_pending", "equals": 10},
    {"action": "assert", "label": "and use up both packs", "actor": "wild", "metric": "item_count", "item": 97870, "equals": 0},

    {"action": "add_item", "actor": "plain", "item": 97885, "count": 1},
    {"action": "client_packet", "label": "A Hero outside Wildcard opens a pack", "actor": "plain", "opcode": 1642, "fields": [{"string": "PURCHASE_SEALED_CARD_TYPE_DEFAULT_PACK"}, {"u32": 1}]},
    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "Packs need Wildcard", "actor": "plain", "metric": "server_packet_contains", "opcode": 1643, "text": "PURCHASE_SEALED_CARD_RANDOM_MODE_NOT_ENABLED", "equals": 1},
    {"action": "assert", "label": "and the pack stays", "actor": "plain", "metric": "item_count", "item": 97885, "equals": 1}
  ]
}
