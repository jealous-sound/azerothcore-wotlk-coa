      "actor": "bloodmage",
      "metric": "spell_damage_done",
      "spell": 501679,
      "effect": 0,
      "target": "dummy",
      "relative_to": "ravenous_before_sp",
      "ratio_to": "sp_gain",
      "min": 0.195,
