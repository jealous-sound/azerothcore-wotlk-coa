{
  "schema": 1,
  "name": "Runemaster Leyborn lets Marked: Runic Brand explode on three Runeblades (#592)",
  "contract": [
    "Leyborn 705609 (Runic talent, passive): 'Your Marked: Runic Brand now stacks 3 times.' Marked: Runic Brand",
    "712323 reads 'Your next$?s705609[ 3][] Runeblade$?s705609[s][] on the enemy causes a Runic Explosion', so the",
    "mark is consumed per Runeblade and Leyborn raises its uses from 1 to 3. Leyborn's only effect is aura 107",
    "SPELL_AURA_ADD_FLAT_MODIFIER, MiscValue 4 (SPELLMOD_CHARGES), BasePoints 1 + DieSides 1 = +2, class mask",
    "(0x100000, 0, 0) = the mark's family 38 flags. The server gives the mark ProcCharges 1 and the Runeblade script",
    "spends one charge per hit, casting Runic Explosion 712324. Expected: with Leyborn the mark has 3 charges and",
    "three Runeblades each explode, a fourth does not; without it the mark has 1 charge and explodes once. The mark",
    "is cast directly, as the Runic Brand's own trigger does."
  ],
  "timeout_ms": 90000,
  "players": [
    {"id": "rm", "race": 1, "class": 32, "level": 80, "melee_hit_rating": 10000, "expertise_rating": 10000,
      "spell_hit_rating": 10000},
    {"id": "plain", "race": 1, "class": 32, "level": 80, "melee_hit_rating": 10000, "expertise_rating": 10000,
      "spell_hit_rating": 10000}
  ],
  "creatures": [
    {"id": "enemy", "owner": "rm", "entry": 36, "level": 80, "health": 2000000, "distance": 3},
    {"id": "plain_enemy", "owner": "plain", "entry": 36, "level": 80, "health": 2000000, "distance": 3}
  ],
  "steps": [
    {"action": "wait", "label": "Let spawn AI settle", "ms": 3000},
    {"action": "learn", "actor": "rm", "spell": 197},
    {"action": "learn", "actor": "plain", "spell": 197},
    {"action": "add_item", "actor": "rm", "item": 12784},
    {"action": "add_item", "actor": "plain", "item": 12784},
    {"action": "equip", "actor": "rm", "item": 12784, "slot": 15},
    {"action": "equip", "actor": "plain", "item": 12784, "slot": 15},
    {"action": "learn", "actor": "rm", "spell": 712323},
    {"action": "learn", "actor": "plain", "spell": 712323},
    {"action": "learn", "actor": "rm", "spell": 573447},
    {"action": "learn", "actor": "plain", "spell": 573447},
    {"action": "learn", "actor": "rm", "spell": 705609},
    {"action": "assert", "label": "Leyborn is active", "actor": "rm", "metric": "aura", "spell": 705609,
      "equals": 1, "within_ms": 2000},
    {"action": "assert", "label": "Leyborn adds two charges to the mark", "actor": "rm", "metric": "spell_modifier",
      "spell": 712323, "op": 4, "base": 1, "equals": 3},
    {"action": "assert", "label": "Without Leyborn the mark keeps one charge", "actor": "plain",
      "metric": "spell_modifier", "spell": 712323, "op": 4, "base": 1, "equals": 1},
    {"action": "restore_charges", "actor": "rm", "spell": 573447},
    {"action": "restore_charges", "actor": "plain", "spell": 573447},
    {"action": "snapshot", "actor": "rm", "metric": "spell_cast_count", "spell": 712324, "save_as": "explosions"},
    {"action": "snapshot", "actor": "rm", "metric": "spell_damage_count", "spell": 573447, "target": "enemy",
      "save_as": "runeblade_hits"},
    {"action": "snapshot", "actor": "plain", "metric": "spell_cast_count", "spell": 712324,
      "save_as": "plain_explosions"},

    {"action": "cast", "actor": "rm", "spell": 712323, "target": "enemy"},
    {"action": "cast", "actor": "plain", "spell": 712323, "target": "plain_enemy"},
    {"action": "assert", "label": "With Leyborn the mark has 3 charges", "actor": "enemy", "metric": "aura_charges",
      "spell": 712323, "caster": "rm", "equals": 3, "within_ms": 1500},
    {"action": "assert", "label": "Without Leyborn the mark has 1 charge", "actor": "plain_enemy",
      "metric": "aura_charges", "spell": 712323, "caster": "plain", "equals": 1, "within_ms": 1500},
    {"action": "wait", "ms": 1200},

    {"action": "cast", "actor": "rm", "spell": 573447, "target": "enemy"},
    {"action": "cast", "actor": "plain", "spell": 573447, "target": "plain_enemy"},
    {"action": "assert", "label": "First Runeblade explodes", "actor": "rm", "metric": "spell_cast_count",
      "spell": 712324, "relative_to": "explosions", "equals": 1, "within_ms": 2000},
    {"action": "assert", "label": "First Runeblade without Leyborn explodes", "actor": "plain",
      "metric": "spell_cast_count", "spell": 712324, "relative_to": "plain_explosions", "equals": 1,
      "within_ms": 2000},
    {"action": "assert", "label": "Two uses of the mark remain", "actor": "enemy", "metric": "aura_charges",
      "spell": 712323, "caster": "rm", "equals": 2},
    {"action": "assert", "label": "Without Leyborn the mark is spent", "actor": "plain_enemy", "metric": "aura",
      "spell": 712323, "caster": "plain", "equals": 0, "within_ms": 1000},
    {"action": "wait", "ms": 1500},

    {"action": "cast", "actor": "rm", "spell": 573447, "target": "enemy"},
    {"action": "cast", "actor": "plain", "spell": 573447, "target": "plain_enemy"},
    {"action": "assert", "label": "Second Runeblade explodes", "actor": "rm", "metric": "spell_cast_count",
      "spell": 712324, "relative_to": "explosions", "equals": 2, "within_ms": 2000},
    {"action": "assert", "label": "One use of the mark remains", "actor": "enemy", "metric": "aura_charges",
      "spell": 712323, "caster": "rm", "equals": 1},
    {"action": "wait", "ms": 1500},
    {"action": "assert", "label": "A second Runeblade without Leyborn does not explode", "actor": "plain",
      "metric": "spell_cast_count", "spell": 712324, "relative_to": "plain_explosions", "equals": 1},

    {"action": "cast", "actor": "rm", "spell": 573447, "target": "enemy"},
    {"action": "assert", "label": "Third Runeblade explodes", "actor": "rm", "metric": "spell_cast_count",
      "spell": 712324, "relative_to": "explosions", "equals": 3, "within_ms": 2000},
    {"action": "assert", "label": "The third Runeblade spends the mark", "actor": "enemy", "metric": "aura",
      "spell": 712323, "caster": "rm", "equals": 0, "within_ms": 1000},
    {"action": "restore_charges", "actor": "rm", "spell": 573447},
    {"action": "wait", "ms": 1500},
    {"action": "cast", "actor": "rm", "spell": 573447, "target": "enemy"},
    {"action": "wait", "ms": 1500},
    {"action": "assert", "label": "SETUP: all four Runeblades hit the enemy", "actor": "rm",
      "metric": "spell_damage_count", "spell": 573447, "target": "enemy", "relative_to": "runeblade_hits",
      "equals": 4},
    {"action": "assert", "label": "A fourth Runeblade does not explode", "actor": "rm", "metric": "spell_cast_count",
      "spell": 712324, "relative_to": "explosions", "equals": 3}
  ]
}
