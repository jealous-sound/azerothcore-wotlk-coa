{
  "schema": 1,
  "name": "Issue 461: Power Engraving grants nearby allies magic damage and critical strike chance",
  "contract": [
    "Power Engraving 500296 reads 'Create a Power Engraving beneath you for $d, granting $s1% increased Magic Damage",
    "dealt and $s2% increased critical strike chance to up to $i allies standing in the area.' Its three effects are",
    "native SPELL_EFFECT_PERSISTENT_AREA_AURA (27) at TARGET_DEST_CASTER with TARGET_UNIT_DEST_AREA_ALLY, radius",
    "index 8 (5 yd), duration index 18 (20 s): effect 0 aura 79 SPELL_AURA_MOD_DAMAGE_PERCENT_DONE, BasePoints 19,",
    "MiscValue 126 (every magic school, not Physical); effect 1 aura 290 SPELL_AURA_MOD_CRIT_PCT, BasePoints 19;",
    "effect 2 aura 21 with amount 0. The ground object must therefore give the caster and an ally standing on it",
    "+20% magic damage (the fixed 1000 base of spell_damage_done becomes 1200 for Arcane Thaumaturgy 804550) and",
    "+20 critical strike points for spells and melee, leave Physical weapon damage unchanged, and take both away",
    "when the 20 s object expires. The 'up to $i' (MaxAffectedTargets 5) cap needs six allies and is not covered:",
    "DynObjAura::FillTargetMap does not read MaxAffectedTargets."
  ],
  "timeout_ms": 120000,
  "location": {"map": 0, "x": -8949.95, "y": -132.493, "z": 83.5312, "o": 0},
  "players": [
    {"id": "rm", "race": 1, "class": 32, "level": 80},
    {"id": "ally", "race": 1, "class": 8, "level": 80}
  ],
  "creatures": [
    {"id": "dummy", "owner": "rm", "entry": 36, "level": 80, "health": 1000000, "distance": 3}
  ],
  "steps": [
    {"action": "wait", "label": "Let spawn AI settle", "ms": 3000},
    {"action": "learn", "actor": "rm", "spell": 500296},
    {"action": "assert", "label": "SETUP: the ally stands on the caster's spot", "actor": "rm",
      "metric": "distance_2d", "target": "ally", "max": 1},
    {"action": "snapshot", "actor": "rm", "metric": "spell_damage_done", "spell": 804550, "target": "dummy",
      "save_as": "rm_arcane"},
    {"action": "snapshot", "actor": "ally", "metric": "spell_damage_done", "spell": 804550, "target": "dummy",
      "save_as": "ally_arcane"},
    {"action": "snapshot", "actor": "rm", "metric": "spell_crit_chance", "school": 6, "save_as": "rm_spell_crit"},
    {"action": "snapshot", "actor": "ally", "metric": "spell_crit_chance", "school": 6, "save_as": "ally_spell_crit"},
    {"action": "snapshot", "actor": "rm", "metric": "melee_crit_chance", "save_as": "rm_melee_crit"},
    {"action": "snapshot", "actor": "rm", "metric": "weapon_damage_min", "save_as": "rm_weapon"},

    {"action": "cast", "actor": "rm", "spell": 500296},
    {"action": "assert", "label": "The engraving is placed beneath the caster", "actor": "rm",
      "metric": "dynamic_object", "spell": 500296, "equals": 1, "within_ms": 1000},
    {"action": "assert", "label": "The caster stands in its own engraving", "actor": "rm",
      "metric": "aura", "spell": 500296, "caster": "rm", "equals": 1, "within_ms": 2000},
    {"action": "assert", "label": "An ally standing in the area receives it", "actor": "ally",
      "metric": "aura", "spell": 500296, "caster": "rm", "equals": 1, "within_ms": 2000},
    {"action": "assert", "actor": "ally", "metric": "aura_amount", "spell": 500296, "effect": 0, "equals": 20},
    {"action": "assert", "actor": "ally", "metric": "aura_amount", "spell": 500296, "effect": 1, "equals": 20},
    {"action": "assert", "label": "Caster's magic damage is 20% higher", "actor": "rm",
      "metric": "spell_damage_done", "spell": 804550, "target": "dummy", "ratio_to": "rm_arcane",
      "min": 1.199, "max": 1.201},
    {"action": "assert", "label": "Ally's magic damage is 20% higher", "actor": "ally",
      "metric": "spell_damage_done", "spell": 804550, "target": "dummy", "ratio_to": "ally_arcane",
      "min": 1.199, "max": 1.201},
    {"action": "assert", "label": "Caster's spell critical strike chance rises by 20 points", "actor": "rm",
      "metric": "spell_crit_chance", "school": 6, "relative_to": "rm_spell_crit", "min": 19.99, "max": 20.01},
    {"action": "assert", "label": "Ally's spell critical strike chance rises by 20 points", "actor": "ally",
      "metric": "spell_crit_chance", "school": 6, "relative_to": "ally_spell_crit", "min": 19.99, "max": 20.01},
    {"action": "assert", "label": "Critical strike chance also covers melee (a ~4% base plus 20)", "actor": "rm",
      "metric": "melee_crit_chance", "min": 20, "max": 30},
    {"action": "assert", "label": "Physical weapon damage is not magic damage", "actor": "rm",
      "metric": "weapon_damage_min", "relative_to": "rm_weapon", "equals": 0},
    {"action": "assert", "actor": "rm", "metric": "dynamic_object_duration_ms", "spell": 500296,
      "min": 15000, "max": 20000},

    {"action": "assert", "label": "The engraving expires after 20 s", "actor": "rm",
      "metric": "dynamic_object", "spell": 500296, "equals": 0, "within_ms": 21000},
    {"action": "assert", "actor": "rm", "metric": "aura", "spell": 500296, "equals": 0, "within_ms": 2000},
    {"action": "assert", "actor": "ally", "metric": "aura", "spell": 500296, "equals": 0, "within_ms": 2000},
    {"action": "assert", "label": "The damage bonus leaves with the engraving", "actor": "ally",
      "metric": "spell_damage_done", "spell": 804550, "target": "dummy", "ratio_to": "ally_arcane",
      "min": 0.999, "max": 1.001},
    {"action": "assert", "label": "The critical strike bonus leaves with the engraving", "actor": "rm",
      "metric": "spell_crit_chance", "school": 6, "relative_to": "rm_spell_crit", "min": -0.01, "max": 0.01}
  ]
}
