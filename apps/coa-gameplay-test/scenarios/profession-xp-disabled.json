      "skill": 186,
      "value": 75,
      "maximum": 75
    },
    {
      "action": "command",
      "actor": "miner",
      "command": ".xp 3"
    },
    {
      "action": "snapshot",
      "actor": "miner",
      "metric": "xp",
      "save_as": "before"
    },
    {
      "action": "gather_skill",
      "actor": "miner",
      "skill": 186,
      "required": 50
    },
    {
      "action": "assert",
      "actor": "miner",
      "metric": "xp",
      "relative_to": "before",
      "equals": 0
