{
  "schema": 1,
  "name": "Crimson Death recasts Slaughter on its stated 20% of casts (#2663)",
  "contract": [
    "Crimson Death 705414 reads: 'Your Slaughter now has a 20% chance to cast an additional time free of cost.'",
    "Forty Slaughter 500373 casts on a target below 35% health expect eight free recasts. One to nineteen recasts is",
    "consistent with 20% (false failure about 1.5e-4) and rejects both a 100% row (forty recasts) and a cast-phase row",
    "whose recast has no target and fails (no recasts). A triggered recast cannot proc Crimson Death again,",
    "because an aura never procs from a spell it triggered itself."
  ],
  "timeout_ms": 180000,
