      "label": "The equipped engraving supplies its native proc aura"},
    {"action": "set_power", "actor": "r", "power": 0, "value": 1000},
    {"action": "cast", "actor": "r", "spell": 712325},
    {"action": "assert", "actor": "r", "metric": "aura", "spell": 712325, "equals": 1, "within_ms": 1000},
    {"action": "assert", "actor": "r", "metric": "spell_modifier", "spell": 653216, "op": 18, "base": 30, "equals": 130,
