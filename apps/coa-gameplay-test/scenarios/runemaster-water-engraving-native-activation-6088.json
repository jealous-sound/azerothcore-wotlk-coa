    {"action": "cast", "actor": "r", "spell": 712325},
    {"action": "assert", "actor": "r", "metric": "aura", "spell": 712325, "equals": 1, "within_ms": 1000},
    {"action": "set_power", "actor": "r", "power": 0, "value": 1000},
    {"action": "reset_cooldown", "actor": "r", "spell": 800732},
    {"action": "cast", "actor": "r", "spell": 800732, "target": "e"},
    {"action": "wait", "ms": 1800},
    {"action": "assert", "actor": "r", "metric": "spell_cast_count", "spell": 653261, "relative_to": "old_payloads",
