    {"action": "snapshot", "actor": "r", "metric": "spell_cast_count", "spell": 653261, "save_as": "old_payloads"},
    {"action": "wait", "ms": 1600},
    {"action": "set_power", "actor": "r", "power": 0, "value": 1000},
    {"action": "cast", "actor": "r", "spell": 653264, "target_item": 2092},
    {"action": "wait", "ms": 1200},
