    {"action": "set_power", "actor": "r", "power": 0, "value": 1000},
    {"action": "reset_cooldown", "actor": "r", "spell": 800732},
    {"action": "cast", "actor": "r", "spell": 800732, "target": "e"},
    {"action": "wait", "ms": 1800},
    {"action": "assert", "actor": "r", "metric": "spell_damage_count", "spell": 800732, "target": "e", "min": 2,
