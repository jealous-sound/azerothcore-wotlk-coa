{
  "schema": 1,
  "name": "Runemaster Water weapon engraving procs from direct damage (#6088)",
  "contract": [
    "Normal Water weapon enchant 653213 equips dummy aura 653214, which must attach proc helper 653216.",
    "The helper has its authored 30% direct-damage proc chance. Normally cast Zenith 712325 adds 100 chance",
    "points, making a normal Primordial Blast hit deterministic. Water payload 653261 must produce a native",
    "mana-restoration event. Replacing Water with Ice removes both Water auras and stops its payloads while",
    "direct damage and Ice still work. Wait out the native 45-second Zenith cooldown for replacement.",
    "Percentage drain, Frost damage coefficients, Earth damage and client tooltips remain unresolved."
  ],
  "timeout_ms": 120000,
  "players": [
    {"id": "r", "race": 1, "class": 32, "level": 42, "spell_hit_rating": 10000}
  ],
  "creatures": [
    {"id": "e", "owner": "r", "entry": 868, "level": 42, "health": 10000000, "distance": 5, "stationary": true}
  ],
  "steps": [
    {"action": "wait", "ms": 3000},
    {"action": "learn", "actor": "r", "spell": 1180},
    {"action": "learn", "actor": "r", "spell": 800732},
    {"action": "learn", "actor": "r", "spell": 653213},
    {"action": "learn", "actor": "r", "spell": 653264},
    {"action": "learn", "actor": "r", "spell": 712325},
    {"action": "add_item", "actor": "r", "item": 2092},
    {"action": "equip", "actor": "r", "item": 2092, "slot": 15},
    {"action": "set_health", "actor": "r", "value": 1000000, "maximum": 1000000},
    {"action": "wait", "ms": 1200},
    {"action": "set_power", "actor": "r", "power": 0, "value": 1000},
    {"action": "reset_cooldown", "actor": "r", "spell": 800732},
    {"action": "cast", "actor": "r", "spell": 800732, "target": "e"},
    {"action": "wait", "ms": 1800},
    {"action": "assert", "actor": "r", "metric": "spell_damage_count", "spell": 800732, "target": "e", "min": 1,
      "label": "Positive direct-damage control before engraving"},
    {"action": "assert", "actor": "r", "metric": "spell_cast_count", "spell": 653261, "equals": 0,
      "label": "No engraving payload without the enchant"},
    {"action": "set_power", "actor": "r", "power": 0, "value": 1000},
    {"action": "cast", "actor": "r", "spell": 653213, "target_item": 2092},
    {"action": "wait", "ms": 1200},
    {"action": "assert", "actor": "r", "metric": "aura", "spell": 653214, "equals": 1,
