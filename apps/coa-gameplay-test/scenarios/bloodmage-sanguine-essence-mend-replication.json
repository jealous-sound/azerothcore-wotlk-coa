{
  "schema": 1,
  "name": "Sanguine Essence repeats Sanguine Mend healing for three seconds",
  "contract": [
    "Sanguine Essence 680692 explicitly replicates 20% of Sanguine Mend healing on its target every 680693 tick",
    "(1000 ms) for 680693 duration (3000 ms). 680692 effect 0 is custom aura 354 with trigger 680693 but has no",
    "proc flags or script binding. Each of three ticks must heal for floor(20% of the original resolved heal),",
    "without applying spell power a second time. Control without the form must produce no echo, and the echo must",
    "not heal the caster or recursively trigger itself. The ally is deeply injured so raw and effective original",
    "healing agree. Overhealing semantics and Bloodmoon Blast replication are separate scope."
  ],
  "timeout_ms": 90000,
  "players": [
    {
      "id": "bloodmage",
      "race": 1,
      "class": 20,
      "level": 80,
      "allow_regeneration": false
    },
    {
      "id": "ally",
      "race": 1,
      "class": 1,
      "level": 80,
      "allow_regeneration": false
    }
  ],
