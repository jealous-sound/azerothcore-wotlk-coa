{
  "schema": 1,
  "name": "Oppressive Ruin extends Ruin's heal-absorb duration to 8 sec (#983)",
  "contract": [
    "Original Spell.dbc gives Ruin 801895 a zero base duration and the Magic damage class. Oppressive Ruin",
    "561201 adds 8000 ms through its flat duration modifier (7999 base points plus DieSides 1), targeting",
    "Ruin's family mask word 1 bit 2. Both level-80 fixtures have native spell-hit rating, enough Energy and",
    "the normal two Felfury cost. Each normal 2500 ms cast and 30 units/sec projectile must be accepted and",
    "deal actual damage before checking its aura. Untalented Ruin has no lasting heal absorb after its hit.",
    "Talented Ruin starts with 7-8 seconds remaining, still has 1-2 seconds after a further six seconds, and",
    "expires after a further two seconds. Polling native damage and remaining duration distinguishes a missed",
    "or unfinished cast from the original duration contract."
  ],
  "timeout_ms": 90000,
  "players": [
    {
      "id": "control",
      "race": 1,
      "class": 14,
      "level": 80,
      "spell_hit_rating": 10000
    },
