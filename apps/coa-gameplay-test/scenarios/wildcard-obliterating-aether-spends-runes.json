{
  "schema": 1,
  "name": "A Wildcard Hero spends runes on Obliterating Aether and sees them come back",
  "contract": "On a Wildcard realm a Hero uses the Death Knight's runes. Obliterating Aether (907878) costs one Frost and one Unholy rune and gives 15 runic power (SpellRuneCost 587), so of three casts in a row the first two strike and give 30 runic power, and the third finds neither rune left. The client neither knows a Hero's rune types nor regenerates its runes, so the server names each rune's type at login (SMSG_CONVERT_RUNE, 0x486), which the client takes as a conversion that spends the rune, and then reports every ready rune, at login and whenever one comes back (SMSG_ADD_RUNE_POWER, 0x488).",
  "timeout_ms": 60000,
  "players": [
    {
      "id": "wild",
      "race": 1,
      "class": 10,
      "level": 20,
      "spell_hit_rating": 10000,
      "melee_hit_rating": 10000,
      "expertise_rating": 10000
    }
  ],
