    {"action": "assert", "label": "its talent scrolls", "actor": "wild", "metric": "item_count", "item": 97933, "equals": 0},
    {"action": "assert", "label": "its redeemed tokens", "actor": "wild", "metric": "player_setting", "source": "core.wildcard.scrolls", "index": 1, "equals": 0},
    {"action": "assert", "label": "and the Case of Fortune", "actor": "wild", "metric": "item_count", "item": 1278048, "equals": 0},
    {"action": "assert", "label": "Three scrolls become repurchasable", "actor": "wild", "metric": "player_setting", "source": "core.wildcard.repurchase", "index": 0, "equals": 3},
    {"action": "assert", "label": "three ability scrolls, tokens included", "actor": "wild", "metric": "player_setting", "source": "core.wildcard.repurchase", "index": 1, "equals": 3},
    {"action": "assert", "label": "and six talent scrolls", "actor": "wild", "metric": "player_setting", "source": "core.wildcard.repurchase", "index": 2, "equals": 6},
    {"action": "assert", "label": "Silas' levelling track starts over", "actor": "wild", "metric": "player_setting", "source": "core.wildcard.rewards", "index": 0, "equals": 0},
    {"action": "assert", "label": "The Prestige pays 100000 Runes of Ascension", "actor": "wild", "metric": "item_count", "item": 375250, "relative_to": "runes_before", "equals": 100000},
    {"action": "assert", "label": "It earns Prestige 1", "actor": "wild", "metric": "has_achievement", "achievement": 13100, "equals": 1},
    {"action": "assert", "label": "and its title, 'Name I'", "actor": "wild", "metric": "has_title", "title": 200, "equals": 1},
    {"action": "login_hooks", "label": "Log in again", "actor": "wild"},
    {"action": "assert", "label": "The login catch-up credits nothing twice", "actor": "wild", "metric": "has_achievement", "achievement": 13101, "equals": 0},

    {"action": "client_packet", "label": "Roll the starting abilities of the new run", "actor": "wild", "opcode": 1611},
    {"action": "wait", "ms": 1500},
    {"action": "assert", "label": "The run starts with the starting choice", "actor": "wild", "metric": "wildcard_spells_known", "equals": 4},
    {"action": "learn", "label": "Read a Tome of Specialization II", "actor": "wild", "spell": 979994},
    {"action": "cast", "label": "Try to switch specialization", "actor": "wild", "spell": 979994},
    {"action": "wait", "ms": 7000},
    {"action": "assert", "label": "The specialization stays locked", "actor": "wild", "metric": "player_setting", "source": "core.wildcard.spec", "index": 0, "equals": 0},
    {"action": "assert", "label": "and the player is told why", "actor": "wild", "metric": "system_message_contains", "text": "prestige locked", "equals": 1},

    {"action": "client_packet", "label": "Buy two scrolls back at level 1", "actor": "wild", "opcode": 1777, "fields": [{"u32": 2}, {"u8": 0}]},
    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "Repurchasing waits for the level cap", "actor": "wild", "metric": "server_packet_contains", "opcode": 1780, "text": "REPURCHASE_WILDCARD_ROLL_NOT_MAX_LEVEL", "equals": 1},
    {"action": "set_level", "actor": "wild", "value": 80},
    {"action": "assert", "label": "Reaching the cap ends Prestige Mode", "actor": "wild", "metric": "aura", "spell": 9930831, "equals": 0, "within_ms": 3000},
    {"action": "snapshot", "actor": "wild", "metric": "item_count", "item": 375250, "save_as": "runes_capped"},
    {"action": "client_packet", "label": "Buy two scrolls back", "actor": "wild", "opcode": 1777, "fields": [{"u32": 2}, {"u8": 0}]},
    {"action": "client_packet", "label": "and three talent scrolls", "actor": "wild", "opcode": 1779, "fields": [{"u32": 3}, {"u8": 0}]},
    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "The repurchase is accepted", "actor": "wild", "metric": "server_packet_contains", "opcode": 1780, "text": "REPURCHASE_WILDCARD_ROLL_OK", "equals": 1},
    {"action": "assert", "label": "Two Scrolls of Fortune I are back", "actor": "wild", "metric": "item_count", "item": 1101244, "equals": 2},
    {"action": "assert", "label": "and three talent scrolls", "actor": "wild", "metric": "item_count", "item": 97933, "equals": 3},
    {"action": "assert", "label": "for 2 x 50 + 3 x 33 runes", "actor": "wild", "metric": "item_count", "item": 375250, "relative_to": "runes_capped", "equals": -199},
    {"action": "assert", "label": "One scroll stays repurchasable", "actor": "wild", "metric": "player_setting", "source": "core.wildcard.repurchase", "index": 0, "equals": 1},
    {"action": "assert", "label": "and three talent scrolls", "actor": "wild", "metric": "player_setting", "source": "core.wildcard.repurchase", "index": 2, "equals": 3}
