    {"action": "wait", "ms": 500},
    {"action": "assert", "actor": "wild", "metric": "player_setting", "source": "core.wildcard.rewards", "index": 0, "equals": 1},
    {"action": "add_item", "actor": "wild", "item": 1101244, "count": 1},
    {"action": "add_item", "actor": "wild", "item": 97913, "count": 2},
    {"action": "use_item", "label": "Redeem two Scrolls of Fortune I: Abilities", "actor": "wild", "item": 97913, "spell": 102791},
    {"action": "wait", "ms": 500},
    {"action": "add_item", "actor": "wild", "item": 97913, "count": 1},
    {"action": "add_item", "actor": "wild", "item": 1278048, "count": 1},
    {"action": "assert", "label": "Three Scrolls of Fortune I", "actor": "wild", "metric": "item_count", "item": 1101244, "equals": 3},
    {"action": "assert", "label": "six talent scrolls", "actor": "wild", "metric": "item_count", "item": 97933, "equals": 6},
    {"action": "assert", "label": "and two redeemed ability scrolls", "actor": "wild", "metric": "player_setting", "source": "core.wildcard.scrolls", "index": 1, "equals": 2},

    {"action": "snapshot", "actor": "wild", "metric": "server_packets", "opcode": 1824, "save_as": "prestige_info"},
    {"action": "gossip_hello", "actor": "wild", "target": "chromie", "label": "Speak to Chromie"},
    {"action": "assert", "label": "Chromie's window gets the repurchasable scrolls", "actor": "wild", "metric": "server_packets", "opcode": 1824, "relative_to": "prestige_info", "equals": 1},
    {"action": "assert", "label": "and the activation option", "actor": "wild", "metric": "gossip_option_text", "index": 0, "text": "I would like to prestige!", "equals": 1},
    {"action": "snapshot", "actor": "wild", "metric": "item_count", "item": 375250, "save_as": "runes_before"},
    {"action": "gossip_select", "actor": "wild", "option": 0, "label": "I would like to prestige!"},
    {"action": "assert", "label": "Back to level 1", "actor": "wild", "metric": "level", "equals": 1, "within_ms": 5000},
    {"action": "assert", "label": "in Prestige Mode", "actor": "wild", "metric": "aura", "spell": 9930831, "equals": 1},
    {"action": "assert", "label": "The build is gone", "actor": "wild", "metric": "wildcard_spells_known", "equals": 0},
    {"action": "assert", "label": "Its Scrolls of Fortune are deleted", "actor": "wild", "metric": "item_count", "item": 1101244, "equals": 0},
