    {"action": "equip", "actor": "rm", "item": 12784, "slot": 15},
    {"action": "learn", "actor": "rm", "spell": 645435},

    {"action": "set_aura", "label": "A harmful magic effect on the Runemaster", "actor": "rm", "spell": 770,
      "stacks": 1},
    {"action": "assert", "label": "SETUP: the harmful magic effect is present", "actor": "rm", "metric": "aura",
      "spell": 770, "equals": 1},
    {"action": "snapshot", "actor": "rm", "metric": "spell_damage_count", "spell": 645437, "target": "enemy",
