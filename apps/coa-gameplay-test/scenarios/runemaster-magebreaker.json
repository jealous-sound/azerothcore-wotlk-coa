    {"action": "cast", "actor": "rm", "spell": 645435, "target": "enemy"},
    {"action": "assert", "label": "A damaging Hurricane strike applies Magebreaker to the target", "actor": "enemy",
      "metric": "aura", "spell": 704430, "caster": "rm", "equals": 1, "within_ms": 1500},
    {"action": "assert", "label": "Magebreaker reduces the target's magic damage done by 15%", "actor": "enemy",
      "metric": "aura_amount", "spell": 704430, "effect": 2, "equals": -15},
    {"action": "assert", "label": "A strike dispels the Runemaster's harmful magic effect", "actor": "rm",
      "metric": "aura", "spell": 770, "equals": 0, "within_ms": 1500},
    {"action": "assert", "actor": "rm", "metric": "aura", "spell": 645435, "equals": 0, "within_ms": 4000},
    {"action": "wait", "ms": 500},
    {"action": "snapshot", "actor": "rm", "metric": "spell_damage_count", "spell": 645437, "target": "enemy",
