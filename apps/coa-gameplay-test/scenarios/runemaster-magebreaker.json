    {"action": "cast", "actor": "rm", "spell": 645435, "target": "enemy"},
    {"action": "assert", "actor": "rm", "metric": "aura", "spell": 645435, "equals": 1, "within_ms": 500},
    {"action": "assert", "actor": "rm", "metric": "aura", "spell": 645435, "equals": 0, "within_ms": 4000},
    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "SETUP: Hurricane struck without the talent", "actor": "rm",
      "metric": "spell_damage_count", "spell": 645437, "target": "enemy", "relative_to": "strikes_before_plain",
      "min": 4},
    {"action": "assert", "label": "Without the talent Hurricane leaves no Magebreaker debuff", "actor": "enemy",
      "metric": "aura", "spell": 704430, "equals": 0},
    {"action": "assert", "label": "Without the talent the harmful magic effect stays", "actor": "rm",
      "metric": "aura", "spell": 770, "equals": 1},

    {"action": "learn", "actor": "rm", "spell": 804061},
    {"action": "assert", "label": "SETUP: Magebreaker is active", "actor": "rm", "metric": "aura", "spell": 804061,
