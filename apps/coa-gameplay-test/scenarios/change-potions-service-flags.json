{
  "schema": 1,
  "name": "Change potions: service flags, one pending service, faction gates and combat refusals",
  "contract": "A customization, race or faction potion sets the matching at-login flag (8 customize, 128 race change, 64 faction change) that the character screen turns into its service button, spends the potion and says so. While one service is pending another potion is refused unspent. Faction Change Potion to Horde (505005) carries ITEM_FLAG2_FACTION_ALLIANCE and to Alliance (505006) ITEM_FLAG2_FACTION_HORDE, so the core refuses each for the other side. In combat every potion, the class potion included, is refused unspent and opens no menu.",
  "timeout_ms": 60000,
  "players": [
    { "id": "fighter", "race": 1, "class": 12, "level": 20 },
    { "id": "customizer", "race": 1, "class": 12, "level": 20 },
    { "id": "horde", "race": 2, "class": 12, "level": 20 }
  ],
  "creatures": [
    { "id": "dummy", "owner": "fighter", "entry": 36, "level": 20, "health": 100000, "distance": 3 }
  ],
  "steps": [
    { "action": "wait", "label": "Let spawn AI settle", "ms": 3000 },
    { "action": "add_item", "actor": "fighter", "item": 200000 },
    { "action": "add_item", "actor": "fighter", "item": 97858 },
    { "action": "attack", "actor": "fighter", "target": "dummy" },
    { "action": "assert", "label": "The fighter is in combat", "actor": "fighter", "metric": "combat",
      "equals": 1, "within_ms": 3000 },
    { "action": "use_item", "actor": "fighter", "item": 200000, "spell": 200164 },
    { "action": "assert", "label": "Combat refuses the customization potion", "actor": "fighter",
      "metric": "notification_contains", "text": "in combat", "equals": 1 },
    { "action": "assert", "label": "The refused potion is kept", "actor": "fighter", "metric": "item_count",
      "item": 200000, "equals": 1 },
    { "action": "assert", "label": "No customization is granted in combat", "actor": "fighter",
      "metric": "at_login_flag", "id": 8, "equals": 0 },
    { "action": "use_item", "actor": "fighter", "item": 97858, "spell": 93216 },
    { "action": "assert", "label": "Combat opens no class menu", "actor": "fighter", "metric": "gossip_options",
      "equals": 0 },
    { "action": "assert", "label": "The class potion is kept", "actor": "fighter", "metric": "item_count",
      "item": 97858, "equals": 1 },
    { "action": "assert", "label": "The fighter keeps its class", "actor": "fighter", "metric": "player_class",
      "equals": 12 },
    { "action": "add_item", "actor": "horde", "item": 505005 },
    { "action": "add_item", "actor": "horde", "item": 505006 },
    { "action": "use_item", "label": "A Horde character tries the Alliance-only potion", "actor": "horde",
      "item": 505005, "spell": 200164 },
    { "action": "assert", "label": "The Alliance-only potion is kept", "actor": "horde", "metric": "item_count",
      "item": 505005, "equals": 1 },
    { "action": "assert", "label": "The Alliance-only potion grants nothing", "actor": "horde",
      "metric": "at_login_flag", "id": 64, "equals": 0 },
    { "action": "add_item", "actor": "customizer", "item": 910201 },
    { "action": "add_item", "actor": "customizer", "item": 200001 },
    { "action": "assert", "label": "No customization is pending yet", "actor": "customizer",
      "metric": "at_login_flag", "id": 8, "equals": 0 },
    { "action": "use_item", "actor": "customizer", "item": 910201, "spell": 200164 },
    { "action": "assert", "label": "Customization is pending", "actor": "customizer", "metric": "at_login_flag",
      "id": 8, "equals": 1 },
    { "action": "assert", "label": "The customization potion is spent", "actor": "customizer",
      "metric": "item_count", "item": 910201, "equals": 0 },
    { "action": "assert", "label": "The notice names the Customize button", "actor": "customizer",
      "metric": "notification_contains", "text": "Customize", "equals": 1 },
    { "action": "assert", "label": "The chat copy links the potion", "actor": "customizer",
      "metric": "system_message_contains", "text": "[Customization Potion]", "equals": 1 },
    { "action": "use_item", "actor": "customizer", "item": 200001, "spell": 200164 },
    { "action": "assert", "label": "A second service is refused", "actor": "customizer",
      "metric": "notification_contains", "text": "already have a character change waiting", "equals": 1 },
    { "action": "assert", "label": "The race potion is kept", "actor": "customizer", "metric": "item_count",
      "item": 200001, "equals": 1 },
    { "action": "assert", "label": "No race change is pending", "actor": "customizer", "metric": "at_login_flag",
      "id": 128, "equals": 0 },
    { "action": "use_item", "label": "The Horde character uses its own faction potion", "actor": "horde",
      "item": 505006, "spell": 200164 },
    { "action": "assert", "label": "Faction change is pending", "actor": "horde", "metric": "at_login_flag",
      "id": 64, "equals": 1 },
    { "action": "assert", "label": "The Horde-only potion is spent", "actor": "horde", "metric": "item_count",
      "item": 505006, "equals": 0 }
  ]
}
