{
  "schema": 1,
  "name": "Class Change Potion: Necromancer to Guardian keeps usable gear and updates the cache",
  "contract": "Using the Class Change Potion (97858) opens a menu of the other 20 CoA classes the race may be, in COA_CLASS_ORDER, and spends nothing. Picking Guardian (option 11 for a Necromancer) spends the potion and makes the character class 18 in play and in the character cache that name queries read. Necromancer baseline spells such as Lichfrost (801722) are removed and Guardian baseline spells such as Pulverize (800311) are granted. Guardian's live baseline includes wand proficiency (5009, skill 228), so an equipped wand stays equipped: the bags gain only the potion's slot. No specialization is left chosen.",
  "timeout_ms": 60000,
  "players": [
    { "id": "changer", "race": 1, "class": 23, "level": 20 }
  ],
  "steps": [
    { "action": "wait", "label": "Let the character settle", "ms": 3000 },
    { "action": "assert", "label": "The character starts as a Necromancer", "actor": "changer",
      "metric": "player_class", "equals": 23 },
    { "action": "assert", "label": "Lichfrost is a Necromancer baseline spell", "actor": "changer",
      "metric": "knows_spell", "spell": 801722, "equals": 1 },
    { "action": "assert", "label": "Pulverize is not known yet", "actor": "changer", "metric": "knows_spell",
      "spell": 800311, "equals": 0 },
    { "action": "assert", "label": "The Necromancer has Staves", "actor": "changer", "metric": "skill_value",
      "skill": 136, "min": 1 },
    { "action": "assert", "label": "The Necromancer has Daggers", "actor": "changer", "metric": "skill_value",
      "skill": 173, "min": 1 },
    { "action": "assert", "label": "The Necromancer has its class skill line", "actor": "changer",
      "metric": "skill_value", "skill": 84, "min": 1 },
    { "action": "add_item", "actor": "changer", "item": 5069 },
    { "action": "equip", "label": "Equip a Fire Wand", "actor": "changer", "item": 5069, "slot": 17 },
    { "action": "assert", "label": "The Necromancer can use wands", "actor": "changer", "metric": "skill_value",
      "skill": 228, "min": 1 },
    { "action": "add_item", "actor": "changer", "item": 97858 },
    { "action": "snapshot", "actor": "changer", "metric": "free_inventory_slots", "save_as": "slots_before" },
    { "action": "use_item", "actor": "changer", "item": 97858, "spell": 93216 },
    { "action": "assert", "label": "The menu lists every other class", "actor": "changer",
      "metric": "gossip_options", "equals": 20 },
    { "action": "assert", "label": "Opening the menu spends nothing", "actor": "changer", "metric": "item_count",
      "item": 97858, "equals": 1 },
    { "action": "gossip_select", "label": "Pick Guardian", "actor": "changer", "option": 11 },
    { "action": "assert", "label": "The character is now a Guardian", "actor": "changer",
      "metric": "player_class", "equals": 18 },
    { "action": "assert", "label": "Name queries see the Guardian too", "actor": "changer",
      "metric": "cached_class", "equals": 18 },
    { "action": "assert", "label": "The potion is spent", "actor": "changer", "metric": "item_count",
      "item": 97858, "equals": 0 },
    { "action": "assert", "label": "The change is announced", "actor": "changer",
      "metric": "notification_contains", "text": "You are now a", "equals": 1 },
    { "action": "assert", "label": "Lichfrost leaves with the Necromancer", "actor": "changer",
      "metric": "knows_spell", "spell": 801722, "equals": 0 },
    { "action": "assert", "label": "Pulverize arrives with the Guardian", "actor": "changer",
      "metric": "knows_spell", "spell": 800311, "equals": 1 },
    { "action": "assert", "label": "Staves leave with the Necromancer", "actor": "changer",
      "metric": "skill_value", "skill": 136, "equals": 0 },
    { "action": "assert", "label": "Daggers leave with the Necromancer", "actor": "changer",
      "metric": "skill_value", "skill": 173, "equals": 0 },
    { "action": "assert", "label": "The Necromancer class skill line leaves", "actor": "changer",
      "metric": "skill_value", "skill": 84, "equals": 0 },
    { "action": "assert", "label": "The Guardian keeps wand skill", "actor": "changer", "metric": "skill_value",
      "skill": 228, "min": 1 },
    { "action": "assert", "label": "The wand stays equipped: only the potion's slot is freed", "actor": "changer",
      "metric": "free_inventory_slots", "relative_to": "slots_before", "equals": 1 },
    { "action": "assert", "label": "No specialization is chosen", "actor": "changer", "metric": "player_setting",
      "source": "core.ascension_active_spec", "index": 0, "equals": 0 }
  ]
}
