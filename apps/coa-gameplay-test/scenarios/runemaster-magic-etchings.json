    {"action": "reset_cooldown", "actor": "rm", "spell": 800732},
    {"action": "set_power", "actor": "rm", "power": 0, "value": 2000},
    {"action": "cast", "actor": "rm", "spell": 800732, "target": "golem"},
    {"action": "assert", "actor": "rm", "metric": "spell_damage_count", "spell": 800732, "target": "golem",
