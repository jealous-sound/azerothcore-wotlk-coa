    { "action": "set_skill", "actor": "tiger", "skill": 762, "value": 300, "maximum": 300 },
    { "action": "learn", "actor": "tiger", "spell": 42777 },
    { "action": "cast", "actor": "tiger", "spell": 42777 },
    {
      "action": "assert", "label": "42777 cast applies its mounted aura",
      "actor": "tiger", "metric": "aura", "spell": 42777, "equals": 1, "within_ms": 6000
    },
    {
      "action": "assert", "label": "42777 sets the mounted unit flag",
      "actor": "tiger", "metric": "mounted", "equals": 1, "within_ms": 6000
    },
    {
      "action": "assert", "label": "42777 sets mount display 21974",
      "actor": "tiger", "metric": "mount_display", "equals": 21974, "within_ms": 6000
    },
    { "action": "wait", "label": "Survive a server tick", "ms": 3000 },
    {
      "action": "assert", "label": "42777 aura persists",
      "actor": "tiger", "metric": "aura", "spell": 42777, "equals": 1
    },
    {
      "action": "assert", "label": "42777 stays mounted",
      "actor": "tiger", "metric": "mounted", "equals": 1
    },
    {
      "action": "assert", "label": "42777 display persists",
      "actor": "tiger", "metric": "mount_display", "equals": 21974
    },

    { "action": "set_skill", "actor": "control", "skill": 762, "value": 300, "maximum": 300 },
    { "action": "learn", "actor": "control", "spell": 499910 },
    { "action": "cast", "actor": "control", "spell": 499910 },
    {
      "action": "assert", "label": "499910 control still mounts display 21973",
      "actor": "control", "metric": "mount_display", "equals": 21973, "within_ms": 6000
