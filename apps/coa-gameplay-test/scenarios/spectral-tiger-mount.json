  "timeout_ms": 120000,
  "players": [
    { "id": "swift", "race": 1, "class": 1, "level": 80 },
    { "id": "regular", "race": 1, "class": 1, "level": 80 },
    { "id": "armored", "race": 1, "class": 1, "level": 80 },
    { "id": "armored_swift", "race": 1, "class": 1, "level": 80 }
  ],
  "steps": [
