{
  "schema": 1,
  "name": "Spectral Tiger mount: 42777 mounts its display and stays mounted",
  "contract": "Spell 42777 must apply a persistent mounted aura and set the mount display to its creature's model (21974). Spell 499910 is a positive control that must keep mounting display 21973. Run speed is not asserted: 42777 carries no mounted-speed effect.",
  "timeout_ms": 120000,
  "players": [
    { "id": "tiger", "race": 1, "class": 1, "level": 80 },
    { "id": "control", "race": 1, "class": 1, "level": 80 }
  ],
  "steps": [
