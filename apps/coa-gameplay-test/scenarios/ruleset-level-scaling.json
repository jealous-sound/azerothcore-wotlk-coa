      "actor": "highrisk",
      "value": 1
    },
    {
      "action": "level_scaling_packet",
      "actor": "pve",
      "value": 1
    },
    {
      "action": "assert",
      "actor": "pve",
      "metric": "view_level",
      "target": "pve_target",
      "equals": 27,
      "within_ms": 2000,
      "label": "in PvE Mode the level-1 creature is viewed at 32 minus the offset"
    },
    {
      "action": "assert",
      "actor": "pve",
      "metric": "quest_level",
      "quest": 7,
      "equals": 20,
      "label": "in PvE Mode Kobold Camp Cleanup plays at its curve's maximum"
    },
    {
      "action": "assert",
      "actor": "warmode",
      "metric": "view_level",
      "target": "warmode_target",
      "equals": 27,
      "within_ms": 2000,
      "label": "before War Mode the creature is scaled like everyone else's"
    },
    {
      "action": "area_trigger",
      "actor": "warmode",
      "id": 562
    },
    {
      "action": "assert",
      "actor": "warmode",
      "metric": "resting",
      "equals": 1,
      "within_ms": 2000,
      "label": "the Lion's Pride Inn trigger makes the character rest"
    },
    {
      "action": "cast",
      "actor": "warmode",
      "spell": 84420
    },
    {
      "action": "assert",
      "actor": "warmode",
      "metric": "aura",
      "spell": 1004119,
      "equals": 1,
      "within_ms": 4000,
      "label": "War Mode is selected in the Lion's Pride Inn"
    },
    {
      "action": "assert",
