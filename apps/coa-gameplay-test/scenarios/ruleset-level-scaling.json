{
  "schema": 1,
  "name": "War Mode and High-Risk switch open-world level scaling off",
  "contract": "The War Mode (1004119) and High-Risk (1004019) auras end their tooltips with \"Level scaling is disabled while in War Mode\" / \"... in High-Risk\"; PvE Mode (9931032) has no such line. Requires DestinyWeaver.Enable=1, DestinyWeaver.LevelScaling=1, offset 5, CoA.QuestLevelScaling=1 and CoA.Ruleset.DisableLevelScaling=1. Every character is level 32, starts in the PvE set the login default gives, and turns open world scaling on through the native request. A level-1 creature is viewed at 27 (32 minus the offset) and Kobold Camp Cleanup (7, authored at 2) plays at 20 from its QuestTemplateScaling.dbc row. Selecting War Mode or High-Risk in an inn holds both to their authored levels in the open world and re-sends the creature's level; selecting PvE Mode again gives the scaling back without a relog.",
  "timeout_ms": 180000,
  "location": {
    "map": 0,
    "x": -9483.25,
    "y": -17.9883,
    "z": 56.9634,
    "o": 0
  },
  "players": [
    {
      "id": "warmode",
      "race": 1,
      "class": 1,
      "level": 32
    },
    {
      "id": "highrisk",
      "race": 1,
      "class": 1,
      "level": 32
    },
    {
      "id": "pve",
      "race": 1,
      "class": 1,
      "level": 32
    }
  ],
  "creatures": [
    {
      "id": "warmode_target",
      "owner": "warmode",
      "entry": 1501,
      "level": 1,
      "distance": 3
    },
    {
      "id": "highrisk_target",
      "owner": "highrisk",
      "entry": 1501,
      "level": 1,
      "distance": 3
    },
    {
      "id": "pve_target",
      "owner": "pve",
      "entry": 1501,
      "level": 1,
      "distance": 3
    }
  ],
