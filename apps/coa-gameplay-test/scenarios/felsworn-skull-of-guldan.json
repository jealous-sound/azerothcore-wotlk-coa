{
  "schema": 1,
  "name": "Skull of Gul'dan raises max health and Energy by 25% (#1166)",
  "contract": "Skull of Gul'dan 800225 applies a direct-handler aura increasing max health (HandleAuraModIncreaseHealthPercent) and max Energy (HandleAuraModIncreaseEnergyPercent) both by 25% for its duration.",
  "timeout_ms": 90000,
  "players": [
    {
      "id": "fel",
      "race": 1,
      "class": 14,
      "level": 80
    }
  ],
  "steps": [
