{
  "schema": 1,
  "name": "Skinning in a dungeon follows the level a scaled character is shown (#5289)",
  "contract": [
    "Requires CoALegendaryItems.DropChance=0: this scenario checks skinning an otherwise empty corpse.",
    "Requires DestinyWeaver.Enable=1 and DestinyWeaver.LevelScaling=1. Inside a scaled five-player dungeon every",
    "creature stands at the viewer's own level held inside the dungeon's LFGDungeons.dbc band",
    "(ScaleDungeonCreatureLevelForViewer); the Stockade (map 34, finder entry 12) has the band 15-59, so a level-15",
    "character is sent a level-20 creature as level 15. The 3.3.5 client colours a corpse's Skinnable line from the",
    "level it was sent, and the server requirement (Spell::CheckCast: skill < 100 needs (level - 10) * 10) must be",
    "computed from the same level: 50 for the level-15 view, 100 for the authored level 20. Skinning 55 therefore",
    "skins the corpse the client shows as skinnable, Skinning 45 is refused with SPELL_FAILED_LOW_CASTLEVEL (49) as",
    "the client's red line says, and with scaling off the authored level 20 applies again and 85 is refused. Black",
    "Riding Wolf 5194 is a beast with skinning table 100001 and no creature loot or money, so its corpse becomes",
    "skinnable as soon as it dies."
  ],
  "timeout_ms": 120000,
  "location": {
    "map": 34,
    "x": 54.23,
    "y": 0.28,
    "z": -18.34,
    "o": 6.26,
    "ignore_access": true
  },
  "players": [
    {
      "id": "ranger",
      "race": 1,
      "class": 21,
      "level": 15,
      "melee_hit_rating": 10000,
      "expertise_rating": 10000
    }
  ],
  "creatures": [
    {
      "id": "shown_orange",
      "owner": "ranger",
      "entry": 5194,
      "level": 20,
      "health": 1,
      "distance": 2
    },
    {
      "id": "shown_red",
      "owner": "ranger",
      "entry": 5194,
      "level": 20,
      "health": 1,
      "distance": 2
    },
    {
      "id": "unscaled",
      "owner": "ranger",
      "entry": 5194,
      "level": 20,
      "health": 1,
      "distance": 2
    }
  ],
  "steps": [
    {
      "action": "wait",
      "label": "Let spawn AI settle",
      "ms": 2000
    },
    {
      "action": "learn",
      "actor": "ranger",
      "spell": 8613
    },
    {
      "action": "set_skill",
      "actor": "ranger",
      "skill": 393,
      "value": 55,
      "maximum": 150
    },
    {
      "action": "level_scaling_packet",
      "actor": "ranger",
      "value": 1
    },
    {
      "action": "assert",
      "label": "The level-20 creature is shown to the level-15 character at 15",
      "actor": "ranger",
      "metric": "view_level",
      "target": "shown_orange",
      "equals": 15,
      "within_ms": 2000
    },
    {
      "action": "assert",
      "label": "The client is sent level 15",
      "actor": "ranger",
      "metric": "sent_level",
      "target": "shown_orange",
      "equals": 15,
      "within_ms": 3000
    },
    {
      "action": "attack",
      "actor": "ranger",
      "target": "shown_orange"
    },
    {
      "action": "assert",
      "actor": "shown_orange",
      "metric": "alive",
      "equals": 0,
      "within_ms": 30000
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "cast",
      "actor": "ranger",
      "spell": 8613,
      "target": "shown_orange"
    },
    {
      "action": "assert",
      "label": "Skinning 55 skins the corpse shown at level 15",
      "actor": "ranger",
      "metric": "spell_cast_count",
      "spell": 8613,
      "equals": 1,
      "within_ms": 5000
    },
    {
      "action": "assert",
      "label": "The skinning is not refused",
      "actor": "ranger",
      "metric": "cast_failure",
      "spell": 8613,
      "equals": 0
    },
    {
      "action": "assert",
      "label": "The skinning loot window opens",
      "actor": "ranger",
      "metric": "loot_count",
      "min": 1,
      "within_ms": 2000
    },
    {
      "action": "close_loot",
      "actor": "ranger"
    },
    {
      "action": "set_skill",
      "actor": "ranger",
      "skill": 393,
      "value": 45,
      "maximum": 150
    },
    {
      "action": "attack",
      "actor": "ranger",
      "target": "shown_red"
    },
    {
      "action": "assert",
      "actor": "shown_red",
      "metric": "alive",
      "equals": 0,
      "within_ms": 30000
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "cast",
      "actor": "ranger",
      "spell": 8613,
      "target": "shown_red"
    },
    {
      "action": "assert",
      "label": "Skinning 45 is below the level-15 requirement of 50",
      "actor": "ranger",
      "metric": "cast_failure",
      "spell": 8613,
      "equals": 49,
      "within_ms": 2000
    },
    {
      "action": "assert",
      "label": "Nothing was skinned",
      "actor": "ranger",
      "metric": "spell_cast_count",
      "spell": 8613,
      "equals": 1
    },
    {
      "action": "set_skill",
      "actor": "ranger",
      "skill": 393,
      "value": 85,
      "maximum": 150
    },
    {
      "action": "level_scaling_packet",
      "actor": "ranger",
      "value": 0
    },
    {
      "action": "assert",
      "label": "Scaling off shows the authored level",
      "actor": "ranger",
      "metric": "view_level",
      "target": "unscaled",
      "equals": 20,
      "within_ms": 2000
    },
    {
      "action": "attack",
      "actor": "ranger",
      "target": "unscaled"
    },
    {
      "action": "assert",
      "actor": "unscaled",
      "metric": "alive",
      "equals": 0,
      "within_ms": 30000
    },
    {
      "action": "wait",
      "ms": 500
    },
    {
      "action": "cast",
      "actor": "ranger",
      "spell": 8613,
      "target": "unscaled"
    },
    {
      "action": "assert",
      "label": "Without scaling the authored level 20 needs 100",
      "actor": "ranger",
      "metric": "cast_failure",
      "spell": 8613,
      "equals": 49,
      "within_ms": 2000
    },
    {
      "action": "assert",
      "label": "Nothing more was skinned",
      "actor": "ranger",
      "metric": "spell_cast_count",
      "spell": 8613,
      "equals": 1
    }
  ]
}
