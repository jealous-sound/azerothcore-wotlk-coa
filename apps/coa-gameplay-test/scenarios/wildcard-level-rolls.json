    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "The scrolls become tokens", "actor": "wild", "metric": "server_packet_contains", "opcode": 1648, "text": "TOKEN_TYPE_SCROLL_OF_FORTUNE_I_ABILITIES", "equals": 1},
    {"action": "assert", "label": "One click stores the whole stack", "actor": "wild", "metric": "player_setting", "source": "core.wildcard.scrolls", "index": 1, "equals": 3},
    {"action": "assert", "label": "The stack is used up", "actor": "wild", "metric": "item_count", "item": 97913, "equals": 0},

    {"action": "snapshot", "actor": "wild", "metric": "player_setting", "source": "core.wildcard", "index": 4, "save_as": "rolled"},
    {"action": "snapshot", "actor": "wild", "metric": "server_packets", "opcode": 1830, "save_as": "builds"},
