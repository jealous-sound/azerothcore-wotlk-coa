    {"action": "client_packet", "label": "Roll the starting abilities", "actor": "wild", "opcode": 1611},
    {"action": "wait", "ms": 1500},
    {"action": "assert", "label": "Four starters are revealed", "actor": "wild", "metric": "server_packets", "opcode": 1569, "equals": 4},

    {"action": "client_packet", "label": "Click the dice at level 1", "actor": "wild", "opcode": 1603, "fields": [{"u32": 0}, {"u32": 0}, {"u32": 0}, {"u8": 0}]},
    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "The starters spend the level-1 essence", "actor": "wild", "metric": "server_packet_contains", "opcode": 1604, "text": "ROLL_ABILITIES_NO_ROLL", "equals": 1},

    {"action": "set_level", "actor": "wild", "value": 10},
    {"action": "client_packet", "label": "Roll at level 10", "actor": "wild", "opcode": 1603, "fields": [{"u32": 0}, {"u32": 0}, {"u32": 0}, {"u8": 0}]},
    {"action": "wait", "ms": 1500},
    {"action": "assert", "label": "Level 10 rolls", "actor": "wild", "metric": "server_packet_contains", "opcode": 1604, "text": "ROLL_ABILITIES_OK", "equals": 1},
    {"action": "assert", "label": "and reveals one entry", "actor": "wild", "metric": "server_packets", "opcode": 1569, "equals": 5},
    {"action": "assert", "label": "The fifth slot holds an ability", "actor": "wild", "metric": "player_setting", "source": "core.wildcard", "index": 4, "min": 1, "max": 1048575},
    {"action": "assert", "label": "Its spell is learned", "actor": "wild", "metric": "wildcard_spells_known", "equals": 5},
    {"action": "assert", "label": "The fifth spell empties the four starter skill card slots", "actor": "wild", "metric": "server_packets", "opcode": 1573, "equals": 4},
    {"action": "client_packet", "label": "Click again at level 10", "actor": "wild", "opcode": 1603, "fields": [{"u32": 0}, {"u32": 0}, {"u32": 0}, {"u8": 0}]},
    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "The second click is answered", "actor": "wild", "metric": "server_packets", "opcode": 1604, "equals": 3},
    {"action": "assert", "label": "but one roll per even level reveals nothing more", "actor": "wild", "metric": "server_packets", "opcode": 1569, "equals": 5},

    {"action": "set_level", "actor": "wild", "value": 11},
    {"action": "client_packet", "label": "Roll at level 11", "actor": "wild", "opcode": 1603, "fields": [{"u32": 0}, {"u32": 0}, {"u32": 0}, {"u8": 0}]},
    {"action": "wait", "ms": 1500},
    {"action": "assert", "label": "Level 11 rolls", "actor": "wild", "metric": "server_packets", "opcode": 1569, "equals": 6},
    {"action": "assert", "label": "The sixth slot holds a talent", "actor": "wild", "metric": "player_setting", "source": "core.wildcard", "index": 5, "min": 8388608, "max": 2147483647},
    {"action": "assert", "label": "The talent's rank is learned", "actor": "wild", "metric": "wildcard_spells_known", "equals": 6},
    {"action": "assert", "label": "Later rolls leave the skill card slots alone", "actor": "wild", "metric": "server_packets", "opcode": 1573, "equals": 4},

    {"action": "set_action_button", "label": "Put the level-10 ability on the bar", "actor": "wild", "button": 11, "wildcard_slot": 4},
    {"action": "client_packet", "label": "Reroll it without a scroll", "actor": "wild", "opcode": 1565, "fields": [{"wildcard_entry": 4}]},
    {"action": "wait", "ms": 500},
