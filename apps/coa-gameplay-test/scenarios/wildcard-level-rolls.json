    {"action": "assert", "label": "Its slot is empty", "actor": "wild", "metric": "player_setting", "source": "core.wildcard", "index": 4, "equals": 0},
    {"action": "assert", "label": "One scroll is spent", "actor": "wild", "metric": "player_setting", "source": "core.wildcard.scrolls", "index": 1, "equals": 2},
    {"action": "assert", "label": "The client keeps five abilities until the replacement, or it offers the starting choice", "actor": "wild", "metric": "server_packets", "opcode": 1830, "relative_to": "builds", "equals": 0},
    {"action": "assert", "label": "The entry is remembered", "actor": "wild", "metric": "player_setting", "source": "core.wildcard.unlearned", "index": 0, "relative_to": "rolled", "equals": 0},
    {"action": "assert", "label": "Its spell leaves the spellbook", "actor": "wild", "metric": "wildcard_spells_known", "equals": 5},
    {"action": "assert", "label": "and the action bar", "actor": "wild", "metric": "action_bar_unknown_spells", "equals": 0},

    {"action": "client_packet", "label": "The client asks for the replacement", "actor": "wild", "opcode": 1603, "fields": [{"u32": 0}, {"u32": 0}, {"u32": 0}, {"u8": 0}]},
    {"action": "wait", "ms": 1500},
    {"action": "assert", "label": "The replacement is rolled", "actor": "wild", "metric": "server_packets", "opcode": 1569, "equals": 7},
    {"action": "assert", "label": "into the freed slot", "actor": "wild", "metric": "player_setting", "source": "core.wildcard", "index": 4, "min": 1, "max": 1048575},
    {"action": "assert", "label": "and learned", "actor": "wild", "metric": "wildcard_spells_known", "equals": 6},
    {"action": "assert", "label": "The client sees the swap in one build", "actor": "wild", "metric": "server_packets", "opcode": 1830, "relative_to": "builds", "equals": 1},

    {"action": "set_level", "actor": "wild", "value": 12},
    {"action": "client_packet", "label": "Reroll a starter while the level-12 roll is unspent", "actor": "wild", "opcode": 1565, "fields": [{"wildcard_entry": 0}]},
    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "The unspent roll comes first", "actor": "wild", "metric": "server_packet_contains", "opcode": 1566, "text": "CA_UNLEARN_WILDCARD_UNSPENT_AE", "equals": 1},

    {"action": "client_packet", "label": "A Hero outside Wildcard clicks", "actor": "plain", "opcode": 1603, "fields": [{"u32": 0}, {"u32": 0}, {"u32": 0}, {"u8": 0}]},
    {"action": "client_packet", "label": "and tries a reroll", "actor": "plain", "opcode": 1565, "fields": [{"u32": 40134}]},
    {"action": "wait", "ms": 500},
    {"action": "assert", "label": "Outside Wildcard nothing is rolled", "actor": "plain", "metric": "server_packet_contains", "opcode": 1604, "text": "ROLL_ABILITIES_NO_ROLL", "equals": 1},
    {"action": "assert", "label": "or rerolled", "actor": "plain", "metric": "server_packet_contains", "opcode": 1566, "text": "CA_UNLEARN_NOT_WILDCARD", "equals": 1}
  ]
