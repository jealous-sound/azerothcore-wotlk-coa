    {"action": "assert", "label": "CONTRACT: the aura expires", "actor": "rm", "metric": "aura", "spell": 500121,
      "equals": 0, "within_ms": 16500},
    {"action": "assert", "label": "CONTRACT: Arcane spell crit returns", "actor": "rm", "metric": "spell_crit_chance",
