    {"action": "assert", "label": "CONTRACT: Glyphic Ruin damage modifier 100 -> 125", "actor": "rm",
      "metric": "spell_modifier", "spell": 801179, "op": 0, "base": 100, "min": 124.99, "max": 125.01},
    {"action": "assert", "label": "CONTRACT: Elemental Burst is not named and stays at 100", "actor": "rm",
