    {"action": "snapshot", "actor": "rm", "metric": "spell_crit_chance", "school": 2, "save_as": "fire_crit"},
    {"action": "snapshot", "actor": "rm", "metric": "spell_crit_chance", "school": 4, "save_as": "frost_crit"},
