{
  "schema": 1,
  "name": "Warsong Peon flees only at low health (#4364)",
  "contract": [
    "The report identifies immediate fleeing on aggro instead of fleeing at low health. Full and 21% health must",
    "not flee; 19% health triggers the 20% low-health gate. Keep the existing one-time warning and native fleeing",
    "movement. Packet assertions verify server delivery to a socketless session, not rendered client chat."
  ],
  "timeout_ms": 60000,
  "location": {
    "map": 1,
    "x": 16226.2,
    "y": 16257.0,
    "z": 13.2022,
    "o": 1.65007
  },
  "players": [
    {
      "id": "hero",
      "race": 1,
      "class": 1,
      "level": 80
    }
  ],
  "creatures": [
    {
      "id": "peon",
      "owner": "hero",
      "entry": 11656,
      "faction": 14,
      "level": 80,
      "health": 100000,
      "reaction": 2,
      "distance": 6
    }
  ],
  "steps": [
    {
      "action": "set_aura",
      "actor": "hero",
      "spell": 10040,
      "stacks": 20
    },
    {
      "action": "set_health",
      "actor": "hero",
      "value": 100000
    },
    {
      "action": "assert",
      "actor": "peon",
      "metric": "combat",
      "equals": 1,
      "within_ms": 5000,
      "label": "The healthy peon enters combat naturally"
    },
    {
      "action": "assert",
      "actor": "peon",
      "metric": "max_health",
      "equals": 100000
    },
    {
      "action": "assert",
      "actor": "peon",
      "metric": "health_pct",
      "equals": 100
    },
    {
      "action": "snapshot",
      "actor": "hero",
      "metric": "server_packets",
      "opcode": 150,
      "row": 16,
      "save_as": "warnings_before_flee"
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "server_packet_contains",
      "opcode": 150,
      "row": 16,
      "text": "attempts to run away in fear!",
      "equals": 0,
      "label": "No flee warning at full health"
    },
    {
      "action": "set_health",
      "actor": "peon",
      "value": 21000
    },
    {
      "action": "wait",
      "ms": 1000
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "server_packet_contains",
      "opcode": 150,
      "row": 16,
      "text": "attempts to run away in fear!",
      "equals": 0,
      "label": "No warning above the low-health threshold"
    },
    {
      "action": "set_health",
      "actor": "peon",
      "value": 19000
    },
    {
      "action": "assert",
      "actor": "peon",
      "metric": "health_pct",
      "equals": 19
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "server_packet_contains",
      "opcode": 150,
      "row": 16,
      "text": "attempts to run away in fear!",
      "equals": 1,
      "within_ms": 6000,
      "label": "The nearby player receives the native flee warning"
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "server_packets",
      "opcode": 150,
      "row": 16,
      "relative_to": "warnings_before_flee",
      "equals": 1,
      "label": "Exactly one warning was sent"
    },
    {
      "action": "assert",
      "actor": "peon",
      "metric": "spline_remaining_ms",
      "min": 200,
      "within_ms": 5000,
      "label": "The fleeing creature starts a movement leg"
    },
    {
      "action": "wait",
      "ms": 1000
    },
    {
      "action": "assert",
      "actor": "hero",
      "metric": "server_packets",
      "opcode": 150,
      "row": 16,
      "relative_to": "warnings_before_flee",
      "equals": 1,
      "label": "The warning does not repeat while the creature remains wounded"
    }
  ]
}
