    { "action": "assert", "actor": "novice", "metric": "trainer_window_state", "spell": 93800, "equals": 0, "label": "Copper Bar Upgrade Kit is offered and available at skill 1" },
    { "action": "assert", "actor": "novice", "metric": "trainer_window_state", "spell": 93867, "equals": 1, "label": "Bronze Bar Upgrade Kit is listed but needs skill 105" },
    { "action": "assert", "actor": "novice", "metric": "trainer_window_state", "spell": 94525, "equals": -1, "label": "Saronite Bar Upgrade Kit is not a row at an Artisan trainer" },
    { "action": "trainer_buy", "actor": "novice", "target": "artisan", "spell": 93800, "label": "learn Copper Bar Upgrade Kit" },
    { "action": "assert", "actor": "novice", "metric": "spellbook_buy_succeeded", "spell": 93800, "equals": 1, "label": "the trainer taught the kit recipe" },
    { "action": "assert", "actor": "novice", "metric": "knows_spell", "spell": 93800, "equals": 1, "label": "the blacksmith knows Copper Bar Upgrade Kit" },
    { "action": "trainer_buy", "actor": "novice", "target": "artisan", "spell": 93867, "label": "ask for Bronze Bar Upgrade Kit at skill 1" },
    { "action": "assert", "actor": "novice", "metric": "spellbook_buy_failed", "spell": 93867, "equals": 1, "label": "the purchase is refused below skill 105" },
    { "action": "assert", "actor": "novice", "metric": "knows_spell", "spell": 93867, "equals": 0, "label": "nothing was learned" },

    { "action": "set_skill", "actor": "veteran", "skill": 164, "value": 425, "maximum": 450 },
    { "action": "gossip_hello", "actor": "veteran", "target": "grandmaster", "label": "talk to Borus Ironbender" },
    { "action": "gossip_select", "actor": "veteran", "option": 0, "label": "ask for training" },
    { "action": "assert", "actor": "veteran", "metric": "trainer_list_packets", "equals": 1, "label": "the trainer window opens" },
