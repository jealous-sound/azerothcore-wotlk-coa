{
  "schema": 1,
  "name": "Mounting stops Twilight Frenzy rather than preserving a mounted channel (#3779)",
  "contract": [
    "Original Twilight Frenzy805751 allows movement, dodge and parry while channeling, but does not permit",
    "mounting or another ordinary cast. Original Timber Wolf580 is a normal mount cast without",
    "cast-while-casting attributes. In an out-of-combat setup, a normal mount request during a working",
    "Twilight Frenzy channel must end the channel before its natural five-second expiry. Successful mounting",
    "must not preserve subsequent channel pulses. A hostile target would put the hunter in combat and make",
    "the mount itself ineligible, so this tests the reported out-of-combat case."
  ],
  "timeout_ms": 90000,
  "players": [
    {
      "id": "hunter",
      "race": 2,
      "class": 15,
      "level": 58,
      "ranged_hit_rating": 10000,
