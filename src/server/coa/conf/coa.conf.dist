# Optional shared-client XP hotspots. Independent of class or realm ruleset.
# MaxContinent: 0 = Azeroth, 1 = Azeroth and Outland, 2 = all three continents.
# The effective ceiling never exceeds the worldserver Expansion setting.
# Azeroth starting zones on map 530 remain eligible with MaxContinent = 0.
# The client FrameXML extension is required for map display and the GM editor.
XPHotspots.Enable = 0
XPHotspots.MaxContinent = 2
XPHotspots.ActiveCount = 3
XPHotspots.BuffSpell = 993945
# Brand: a short label (32 characters at most, no "|") the client shows with the hotspots; empty = none.
XPHotspots.Brand = ""
